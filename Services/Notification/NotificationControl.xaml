<UserControl x:Class="Toltech.App.Services.Notification.NotificationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="90" d:DesignWidth="450"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             AutomationProperties.LiveSetting="Assertive">

    <!-- Marge extérieure : laisse la place à l'ombre portée -->
    <Grid Margin="12">

        <!-- Les couleurs (Background, BorderBrush, Foreground...) sont posées par le code-behind
             selon le thème (WPF-UI si présent, sinon SystemColors) -->
        <Border x:Name="Card"
                MinWidth="350" MaxWidth="800"
                CornerRadius="8"
                BorderThickness="1"
                Cursor="Hand"
                MouseLeftButtonDown="OnNotificationClicked">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.28" Color="Black"/>
            </Border.Effect>

            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTranslate"/>
            </Border.RenderTransform>

            <!-- ClipHost : reçoit un clip arrondi pour que le remplissage respecte les coins de la carte -->
            <Grid x:Name="ClipHost">

                <!-- Remplissage animé (ScaleX 0 → 1) : plus fluide qu'une animation de Width -->
                <Border x:Name="Fill"
                        Opacity="0.14"
                        IsHitTestVisible="False"
                        RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="FillScale" ScaleX="0"/>
                    </Border.RenderTransform>
                </Border>

                <Grid Margin="14,10,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icône (glyphe Segoe Fluent Icons, repli sur Segoe MDL2 Assets sous Windows 10) -->
                    <TextBlock x:Name="IconText"
                               Grid.Column="0"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="20"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Text="&#xE946;"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Text="Notification Toltech"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="MessageText"
                                   FontSize="14"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Indice visuel "cliquer pour fermer" -->
                    <TextBlock x:Name="CloseText"
                               Grid.Column="2"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="10"
                               VerticalAlignment="Top"
                               Margin="12,2,0,0"
                               Text="&#xE711;"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
