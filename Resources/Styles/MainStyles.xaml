<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Toltech.App.Converters"
                    xmlns:behaviors="clr-namespace:Toltech.App.Behaviors"
                    xmlns:dragablz="clr-namespace:Dragablz;assembly=Dragablz"
                    xmlns:lang="clr-namespace:Toltech.App.Resources.Lang"
                    xmlns:cad="clr-namespace:Toltech.App.Services.CAD"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    
    <!--
    Ce fichier contient les styles et ressources globales de l'application.
    Il centralise la définition des apparences des contrôles (boutons, TextBox, DataGrid, etc.),
    les couleurs, polices et thèmes utilisés dans toute l'application.
    -->
    
    <!-- Styles génériques -->
    <Style x:Key="WindowThemeStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
    </Style>

    <Style x:Key="GridThemeStyle" TargetType="Grid">
        <Setter Property="Background" Value="{DynamicResource PrimaryBackground}" />
    </Style>

    <Style x:Key="PageDefaultStyle" TargetType="Page">
        <Setter Property="Margin" Value="10,10,10,0" />
    </Style>
 
    <!-- Surface principale : ressources de thème WPF-UI -->
    <Style x:Key="PageCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <!-- Bouton icône 40x40 de l'en-tête -->
    <Style x:Key="HeaderIconButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    
    <Style x:Key="BorderThemeStyle" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource SecondaryBackgroundColor}" Opacity="0.8"/>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}" />

        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="2" />
    </Style>

    <Style x:Key="BaseTextBoxUI" TargetType="{x:Type ui:TextBox}"  BasedOn="{StaticResource {x:Type ui:TextBox}}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />

    </Style>
    <Style TargetType="{x:Type ui:TextBox}" BasedOn="{StaticResource {x:Type ui:TextBox}}">
        <!--<Setter Property="HorizontalContentAlignment" Value="Stretch" />-->

    </Style>

    <!-- Convertisseur pour gérer visibilité du placeholder -->
    <conv:TextOrFocusToVisibilityConverter x:Key="TextOrFocusToVisibilityConverter"/>
   
    <!-- Style par défaut pour toutes les TextBox -->
    <Style x:Key="BaseTextBox" TargetType="TextBox">
        <!-- Apparence de base -->
        <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}" />
        <Setter Property="Cursor" Value="IBeam"/>
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4,4"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>

        <Setter Property="behaviors:TextBoxEnterBehavior.MoveFocusOnEnter" Value="True"/>

        <!-- Template avec placeholder -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <!-- Zone de texte réelle -->
                        <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="0"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <!-- Placeholder -->
                        <TextBlock 
                        Text="{Binding RelativeSource={RelativeSource TemplatedParent},
                                       Path=(behaviors:PlaceholderService.Placeholder)}"
                        Foreground="#777"
                        Margin="6,0,0,0"
                        IsHitTestVisible="False"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                             <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource TextOrFocusToVisibilityConverter}">
                                    <Binding Path="Text.Length" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="IsKeyboardFocused" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </MultiBinding> 
                            </TextBlock.Visibility>
                        </TextBlock>
                    </Grid>

                    <!-- Triggers pour hover, focus, désactivé -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{Binding Background.Color, RelativeSource={RelativeSource Self}}" Opacity="0.85"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DisabledBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--<Style TargetType="TextBox" BasedOn="{StaticResource BaseTextBox}" />-->

    <!-- TextBox personnalisé -->
    <Style x:Key="NumericTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="behaviors:TextBoxInputFilterBehavior.InputFilter" Value="Numeric" />

        <!-- Définir le ToolTip dynamique -->
        <Setter Property="ToolTip">
            <Setter.Value>
                <ToolTip>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ToolTip}}"/>
                        <TextBlock Text="{lang:Loc DefaultUnit}" />
                    </StackPanel>
                </ToolTip>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================= -->
    <!-- BASE : contient tout le menu contextuel                    -->
    <!-- ========================================================= -->
    <Style x:Key="NumericBoxCadBaseStyle"
       TargetType="{x:Type ui:NumberBox}"
       BasedOn="{StaticResource {x:Type ui:NumberBox}}">

        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu Padding="4" HasDropShadow="True">

                    <!-- Sélection CAO (titre fourni par le style dérivé) -->
                    <MenuItem FontWeight="SemiBold"
                          Header="{Binding PlacementTarget.(cad:CadCommand.Header),
                                   RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">

                        <!-- FreeCAD (commande fournie par le style dérivé) -->
                        <MenuItem Header="FreeCAD"
                              Command="{Binding PlacementTarget.(cad:CadCommand.Command),
                                        RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                              CommandTarget="{Binding PlacementTarget,
                                        RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                              CommandParameter="{Binding PlacementTarget,
                                        RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                            <MenuItem.Icon>
                                <Image Source="/Asset/Logos/FreeCAD.png" Width="20" Height="20" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="CATIA V5" IsEnabled="False">
                            <MenuItem.Icon>
                                <Image Source="/Asset/Logos/CATIAV5.png" Width="20" Height="20" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="SOLIDWORKS" IsEnabled="False">
                            <MenuItem.Icon>
                                <Image Source="/Asset/Logos/SOLIDWORKS.png" Width="20" Height="20" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="Siemens NX" IsEnabled="False">
                            <MenuItem.Icon>
                                <Image Source="/Asset/Logos/Siemens_NX.png" Width="20" Height="20" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="Inventor" IsEnabled="False">
                            <MenuItem.Icon>
                                <Image Source="/Asset/Logos/Inventor.png" Width="20" Height="20" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>

                    <!-- Actions classiques -->
                    <Separator/>

                    <MenuItem Header="Copier"
                          Command="ApplicationCommands.Copy"
                          CommandTarget="{Binding PlacementTarget,
                              RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>

                    <MenuItem Header="Coller"
                          Command="ApplicationCommands.Paste"
                          CommandTarget="{Binding PlacementTarget,
                              RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                </ContextMenu>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================= -->
    <!-- Dérivé : sélection d'un POINT                              -->
    <!-- ========================================================= -->
    <Style x:Key="NumericBoxCadPointStyle"
       TargetType="{x:Type ui:NumberBox}"
       BasedOn="{StaticResource NumericBoxCadBaseStyle}">
        <Setter Property="cad:CadCommand.Header" Value="Sélectionner un point dans la CAO"/>
        <Setter Property="cad:CadCommand.Command" Value="{x:Static cad:CadCommands.PickPoint}"/>
    </Style>

    <!-- ========================================================= -->
    <!-- Dérivé : sélection d'une ARÊTE                             -->
    <!-- ========================================================= -->
    <Style x:Key="NumericBoxCadEdgeStyle"
       TargetType="{x:Type ui:NumberBox}"
       BasedOn="{StaticResource NumericBoxCadBaseStyle}">
        <Setter Property="cad:CadCommand.Header" Value="Sélectionner une arête dans la CAO"/>
        <Setter Property="cad:CadCommand.Command" Value="{x:Static cad:CadCommands.PickEdge}"/>
    </Style>

    <Style x:Key="AlphabeticTextBoxStyle" TargetType="TextBox">
        <Setter Property="behaviors:TextBoxInputFilterBehavior.InputFilter" Value="Alphabetic"/>
    </Style>

    <Style x:Key="ToleranceTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="behaviors:TextBoxInputFilterBehavior.InputFilter" Value="Numeric" />

        <!-- Définir le ToolTip dynamique -->
        <Setter Property="ToolTip">
            <Setter.Value>
                <ToolTip>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="± " />
                        <TextBlock Text="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ToolTip}}"/>
                        <TextBlock Text="{lang:Loc DefaultUnit}" />
                    </StackPanel>
                </ToolTip>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TabItemStyle" TargetType="TabItem">
        <!-- Définition par défaut -->
        <Setter Property="Background" Value="{DynamicResource TabItemBackgroundNormal}"/>
        <Setter Property="Foreground" Value="{DynamicResource TabItemForegroundNormal}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="40,6"/>
        <Setter Property="BorderThickness" Value="0"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter 
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            ContentSource="Header"/>
                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Sélection -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Border" 
                                    Property="Background" 
                                    Value="{DynamicResource TabItemBackgroundSelected}"/>       
                            <Setter Property="Foreground" 
                                    Value="{DynamicResource TabItemForegroundSelected}"/>
                        </Trigger>

                        <!-- Survol -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" 
                                    Property="Background" 
                                    Value="{DynamicResource TabItemBackgroundHover}"/>      
                        </Trigger>

                        <!-- Désactivé -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" 
                                     Value="{DynamicResource PrimaryForegroundColor}"/>
                            <Setter TargetName="Border" 
                                    Property="Background" 
                                    Value="{DynamicResource SecondaryBackgroundColor}"/>        
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CustomDragablzTabItemStyle" TargetType="dragablz:DragablzItem"  BasedOn="{StaticResource TrapezoidDragableTabItemStyle}">
        <!-- Couleurs personnalisables -->
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}" />

        <!-- État sélectionné -->
        <Style.Triggers>
            <!-- Trigger simple pour IsSelected -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryBackgroundBrush}" />
            </Trigger>

            <!-- Trigger simple pour IsMouseOver -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
            </Trigger>

            <!-- MultiTrigger pour une condition combinée -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="DarkBlue" />
                <!-- Exemple de couleur spécifique -->
            </MultiTrigger>
        </Style.Triggers>
    </Style>


    <Style x:Key="WindowButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Survol -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
                        </Trigger>
                        <!-- Pressé -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="ListBoxReqs" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                     Background="{TemplateBinding Background}"
                     BorderBrush="{TemplateBinding BorderBrush}"
                     BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter
                     VerticalAlignment="Stretch"
                     HorizontalAlignment="Stretch"
                     Margin="{TemplateBinding Padding}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Suppression totale de l'effet Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                        </Trigger>

                        <!-- Suppression de la sélection visible -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToleranceGroupRadioButtonStyle" TargetType="RadioButton">
        <!-- Taille -->
        <Setter Property="Width" Value="23"/>
        <Setter Property="Height" Value="23"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Padding" Value="0"/>

        <!-- Typographie -->
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <!-- Couleurs de base (état non coché) -->
        <Setter Property="Background" Value="{DynamicResource PanelDataOffSecondaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryBorderBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Content"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      TextElement.FontSize="{TemplateBinding FontSize}"
                                      TextElement.FontWeight="{TemplateBinding FontWeight}"
                                      TextElement.FontFamily="{TemplateBinding FontFamily}"
                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- État coché : mise en avant du groupe actif -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}"/>
                        </Trigger>

                        <!-- Survol souris (état non coché uniquement, pour ne pas gêner la lecture du coché) -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelDataSecondaryBrush}"/>
                        </Trigger>

                        <!-- Désactivé (type de tolérance non applicable à la liaison en cours) -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelDataOffPrimaryBrush}"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="No"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



</ResourceDictionary>