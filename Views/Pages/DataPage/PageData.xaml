<UserControl x:Class="Toltech.App.Views.PageData"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Toltech.App.Views"
             xmlns:models="clr-namespace:Toltech.App.Models"
             xmlns:localControls="clr-namespace:Toltech.App.FrontEnd.Controls"
             xmlns:conv="clr-namespace:Toltech.App.Converters"
             xmlns:lang="clr-namespace:Toltech.App.Resources.Lang"
             Loaded="Page3Load"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="PageDataName">

    <UserControl.Resources>
        <conv:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter"/>
        <conv:IdToNameConverter x:Key="IdToNameConverter"/>
        <conv:BoolToDynamicResourceConverter x:Key="BoolToDynamicResourceConverter"/>
        <conv:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>


    </UserControl.Resources>

    <DockPanel LastChildFill="True" Margin="0">

        <!-- ======================= Arborescence (gauche, largeur fixe) ======================= -->
        <Border DockPanel.Dock="Left" Style="{StaticResource PageCardStyle}">
            <Grid x:Name="GridTreeView" Width="250">
                <localControls:TreeViewAreaV3 x:Name="TreeView" DataContext="{Binding TreeVM}"/>
            </Grid>
        </Border>

        <!-- ======================= Zone principale ======================= -->
        <Border Style="{StaticResource PageCardStyle}" Margin="12,0,0,0">
            <Grid x:Name="MainGridData" ShowGridLines="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ===================== EN-TÊTE ===================== -->
                <Border x:Name="HeaderPage3" Grid.Row="0" Margin="16,12">
                    <Grid ShowGridLines="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Compteurs + pièce fixe -->
                        <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock FontSize="14" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="{lang:Loc NumberPart}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding NumberOfParts, Mode=OneWay}" FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </TextBlock>
                                <TextBlock FontSize="14" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="{lang:Loc NumberReq}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding NumberOfReq, Mode=OneWay}" FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Séparateur vertical (un Separator horizontal n'a pas de sens dans un StackPanel horizontal) -->
                            <Border Width="1" Height="36" Margin="16,0"
                                    Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="IsFixedPartText"
                                          MinWidth="150"
                                          VerticalAlignment="Center"
                                          ToolTip="Définition de la pièce fixe"
                                          ItemsSource="{Binding MainVM.Parts}"
                                          DisplayMemberPath="NamePart"
                                          SelectedItem="{Binding FixedPart, Mode=TwoWay}"/>
                                <Image Source="/Asset/IsFixedPartImg.png" Stretch="Uniform" Width="20" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Nom de la pièce active + infobulle détaillée -->
                        <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="TextBoxPartActif"
                                       Text="{Binding SelectedPartName}"
                                       FontWeight="SemiBold"
                                       FontSize="20"
                                       TextWrapping="Wrap"
                                       MaxWidth="400"
                                       TextAlignment="Center"
                                       ToolTipService.ShowDuration="101000">
                                <TextBlock.ToolTip>
                                    <ToolTip Placement="Mouse" Padding="12" MaxWidth="350">
                                        <StackPanel DataContext="{Binding ActivePart, UpdateSourceTrigger=PropertyChanged}"
                                                    HorizontalAlignment="Left">

                                            <TextBlock Text="{lang:Loc ToolTipPart}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>

                                            <Separator Margin="0,8"/>

                                            <TextBlock Margin="0,3" TextWrapping="Wrap">
                                                <Run Text="{lang:Loc Name}" FontWeight="SemiBold"/>
                                                <Run Text=" : "/>
                                                <Run Text="{Binding NamePart, Mode=OneWay}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,3" TextWrapping="Wrap">
                                                <Run Text="{lang:Loc MasseVol}" FontWeight="SemiBold"/>
                                                <Run Text=" : "/>
                                                <Run Text="{Binding MasseVol, Mode=OneWay}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,3" TextWrapping="Wrap">
                                                <Run Text="{lang:Loc Comment}" FontWeight="SemiBold"/>
                                                <Run Text=" : "/>
                                                <Run Text="{Binding Comment, Mode=OneWay}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,3" TextWrapping="Wrap">
                                                <Run Text="{lang:Loc Part_Fixed}" FontWeight="SemiBold"/>
                                                <Run Text=" : "/>
                                                <Run Text="{Binding IsFixed, Mode=OneWay,
                                                                    Converter={StaticResource BoolToDynamicResourceConverter},
                                                                    ConverterParameter='Part_Fixed;Part_NotFixed'}"/>
                                            </TextBlock>

                                            <StackPanel Margin="0,6,0,0">
                                                <TextBlock Text="{lang:Loc Picture}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <Border Style="{StaticResource PageCardStyle}"
                                                        Width="80" Height="80" HorizontalAlignment="Left">
                                                    <Image Stretch="Uniform" MaxHeight="60" MaxWidth="60"
                                                           Source="{Binding ImagePart, Converter={StaticResource ByteArrayToImageConverter}}"/>
                                                </Border>
                                            </StackPanel>

                                            <Separator Margin="0,8"/>

                                            <!-- Nombre de liaisons.
                                                 Avant : binding sur le ToolTip lui-même (Datas.Count introuvable) et sans Grid.Row,
                                                 donc superposé au titre. Le DataContext du ToolTip vient de la cible (page). -->
                                            <TextBlock Margin="0,3" TextWrapping="Wrap">
                                                <Run Text="Nb de liaison" FontWeight="SemiBold"/>
                                                <Run Text=" : "/>
                                                <Run Text="{Binding DataContext.Datas.Count, Mode=OneWay,
                                                                    RelativeSource={RelativeSource AncestorType=ToolTip}}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>

                        <!-- Boutons d'action -->
                        <StackPanel Orientation="Horizontal"
                                    Grid.Column="3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">

                            <ui:Button x:Name="BtnCreatePart"
                                       Style="{StaticResource HeaderIconButtonStyle}"
                                       Command="{Binding CreatePartCommand}"
                                       ToolTip="Création d'une pièce">
                                <Image Source="/Asset/add_part2.png" Stretch="Uniform"/>
                            </ui:Button>
                            <ui:Button x:Name="BtnDeletePart"
                                       Style="{StaticResource HeaderIconButtonStyle}"
                                       Margin="8,0,0,0"
                                       Command="{Binding DeletePartCommand}"
                                       ToolTip="Suppresion de la pièce active">
                                <Image Source="/Asset/bin_part2.png" Stretch="Uniform"/>
                            </ui:Button>

                            <Border Width="1" Height="28" Margin="12,0"
                                    Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

                            <ui:Button x:Name="IsoButton"
                                       Style="{StaticResource HeaderIconButtonStyle}"
                                       Command="{Binding CheckIsoPartCommand}"
                                       ToolTip="Isostatisme locale">
                                <Image Source="/Asset/HyperstatismeLogo.png" Stretch="Uniform"/>
                            </ui:Button>
                            <ui:Button x:Name="MultiEditButton"
                                       Style="{StaticResource HeaderIconButtonStyle}"
                                       Margin="8,0,0,0"
                                       Click="MultiEdit_Click"
                                       ToolTip="Edition multiple des données">
                                <Image Source="/Asset/MultiEdit.png" Stretch="Uniform"/>
                            </ui:Button>
                            <ui:Button x:Name="SaveButton"
                                       Style="{StaticResource HeaderIconButtonStyle}"
                                       Margin="8,0,0,0"
                                       Icon="{ui:SymbolIcon Save24}" FontSize="35"
                                       Command="{Binding SaveAllCommand}"
                                       ToolTip="Sauvegade totale"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Séparateur (remplace le Border + DropShadow) -->
                <Border x:Name="Barre" Grid.Row="1" Margin="20,0"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

                <!-- ===================== CONTENU ===================== -->
                <Grid Grid.Row="2" ShowGridLines="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="1"/>
                    </Grid.RowDefinitions>

                    <!-- État vide : aucune donnée -->
                    <Grid x:Name="NoDatasPicture" Grid.Row="1" Margin="0,50,0,0"
                          Visibility="{Binding Datas.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                        <StackPanel x:Name="EmptyDataPanel" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <TextBlock Text="{lang:Loc NoModelData1}" Style="{StaticResource EmptyDataTextBlockStyle}"/>
                            <TextBlock Text="{lang:Loc NoModelData2}" Style="{StaticResource EmptyDataTextBlockStyle}"/>
                            <Image Source="/Asset/ImageEmptyDatas.png"
                                   MaxWidth="700" Stretch="Uniform" Margin="0,16,0,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </StackPanel>
                    </Grid>

                    <!-- Liste des données -->
                    <Grid x:Name="MainListBoxGrid" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- ListBox : virtualisation + scroll intégrés -->
                        <ListBox x:Name="ListBoxDatas"
                                 ItemsSource="{Binding Datas}"
                                 SelectedItem="{Binding SelectedData, Mode=TwoWay}"
                                 SelectionMode="Single"
                                 Focusable="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ItemContainerStyle="{DynamicResource ListBoxReqs}"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <!-- Marge haute : laisse la place au header flottant -->
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Margin="0,30,0,0"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ModelData}">
                                    <localControls:PanelData x:Name="PanelModelerControl"
                                                             Data="{Binding}"
                                                             ParentViewModel="{Binding DataContext, RelativeSource={RelativeSource AncestorType=local:PageData}}"
                                                             Margin="12,5"
                                                             Padding="10"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Bouton d'ajout + compteur -->
                        <StackPanel Grid.Column="0" Margin="20" Orientation="Vertical" HorizontalAlignment="Right">
                            <ui:Button Width="50" Height="50" Padding="0"
                                       HorizontalAlignment="Center"
                                        Style="{StaticResource HeaderIconButtonStyle}"
                                       Icon="{ui:SymbolIcon Add24}"
                                       FontSize="22"
                                       Command="{Binding CreateDataCommand}"
                                       CommandParameter="{Binding SelectedPartId}"/>
                            <TextBlock Text="{Binding Datas.Count}"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Panneau de remplacement (affiché par le code-behind) -->
                    <Border x:Name="EmptyPlaceholderGrid"
                            Grid.Row="1"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,50,0,0"
                            Padding="20"
                            Style="{StaticResource PageCardStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="NamePartBox"
                                       Text="{Binding PartActifText}"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>
                            <Image x:Name="PlaceholderImage"
                                   Source="/Asset/BatiPicture.png"
                                   Stretch="Uniform"
                                   Width="400" Height="300"/>
                            <TextBlock Text="{lang:Loc TipFixedPart}"
                                       FontSize="18"
                                       TextAlignment="Center"
                                       Margin="0,12,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{lang:Loc TipCheckActiveParts}"
                                       FontSize="14"
                                       TextAlignment="Center"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Header flottant : filtres d'affichage -->
                    <Grid x:Name="FloatingHeader"
                          Grid.Row="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top">

                        <!-- Animation verticale du header -->
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="HeaderTransform" Y="0"/>
                        </Grid.RenderTransform>

                        <!-- Conteneur responsive des filtres -->
                        <Border HorizontalAlignment="Stretch"
                                Background="Transparent"
                                Panel.ZIndex="2"
                                MouseEnter="FloatingHeader_MouseEnter"
                                MouseLeave="FloatingHeader_MouseLeave">

                            <!-- Retour à la ligne automatique si nécessaire -->
                            <WrapPanel x:Name="StackHeaderButtons"
                                       Orientation="Horizontal"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top">

                                <!-- Filtre : Part 1 -->
                                <Border MinWidth="100"
                                        Padding="10,5"
                                        
                                        Background="Transparent">

                                    <StackPanel HorizontalAlignment="Center">

                                        <ui:TextBlock Text="{lang:Loc Part1}"
                                  HorizontalAlignment="Center"
                                  TextAlignment="Center"
                                  TextWrapping="Wrap"
                                  />

                                        <ui:ToggleSwitch Tag="1"
                                     HorizontalAlignment="Center"
                                     IsChecked="{Binding IsEyeVisible1, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Filtre : Tolérance interne -->
                                <Border MinWidth="100"
                    Padding="10,5"
                    
                    Background="Transparent">

                                    <StackPanel HorizontalAlignment="Center">

                                        <ui:TextBlock Text="{lang:Loc ToleranceInt}"
                                  HorizontalAlignment="Center"
                                  TextAlignment="Center"
                                  TextWrapping="Wrap"
                                  />

                                        <ui:ToggleSwitch Tag="2"
                                     HorizontalAlignment="Center"
                                     IsChecked="{Binding IsEyeVisible2, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Filtre : Part 2 -->
                                <Border MinWidth="100"
                    Padding="10,5"
                    
                    Background="Transparent">

                                    <StackPanel HorizontalAlignment="Center">

                                        <ui:TextBlock Text="{lang:Loc Part2}"
                                  HorizontalAlignment="Center"
                                  TextAlignment="Center"
                                  TextWrapping="Wrap"
                                  />

                                        <ui:ToggleSwitch Tag="3"
                                     HorizontalAlignment="Center"
                                     IsChecked="{Binding IsEyeVisible3, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Filtre : Coordonnées -->
                                <Border MinWidth="100"
                    Padding="10,5"
                    
                    Background="Transparent">

                                    <StackPanel HorizontalAlignment="Center">

                                        <ui:TextBlock Text="{lang:Loc Coordinate}"
                                  HorizontalAlignment="Center"
                                  TextAlignment="Center"
                                  TextWrapping="Wrap"
                                  />

                                        <ui:ToggleSwitch Tag="4"
                                     HorizontalAlignment="Center"
                                     IsChecked="{Binding IsEyeVisible4, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Filtre : Commentaire -->
                                <Border MinWidth="100"
                    Padding="10,5"
                    
                    Background="Transparent">

                                    <StackPanel HorizontalAlignment="Center">

                                        <ui:TextBlock Text="{lang:Loc Comment}"
                                  HorizontalAlignment="Center"
                                  TextAlignment="Center"
                                  TextWrapping="Wrap"
                                  />

                                        <ui:ToggleSwitch Tag="5"
                                     HorizontalAlignment="Center"
                                     IsChecked="{Binding IsEyeVisible5, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Border>

                            </WrapPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

    </DockPanel>
</UserControl>
