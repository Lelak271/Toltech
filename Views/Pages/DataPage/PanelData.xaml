<UserControl x:Class="Toltech.App.FrontEnd.Controls.PanelData"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Toltech.App"
             xmlns:vm="clr-namespace:Toltech.App.ViewModels"
             xmlns:behaviors="clr-namespace:Toltech.App.Behaviors"
             xmlns:localControls="clr-namespace:Toltech.App.FrontEnd.Controls"
             xmlns:utilities="clr-namespace:Toltech.App.Utilities"
             xmlns:localTol="clr-namespace:Toltech.App.Views.Pages.DataPage"
             xmlns:conv="clr-namespace:Toltech.App.Converters"
             xmlns:lang="clr-namespace:Toltech.App.Resources.Lang"
             xmlns:cad="clr-namespace:Toltech.App.Services.CAD"
             mc:Ignorable="d"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Focusable="True"
             x:Name="PanelDataName">

    <!-- ===================== -->
    <!-- Ressources et styles  -->
    <!-- ===================== -->
    <UserControl.Resources>

        <conv:IdToNameConverter x:Key="IdToNameConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:LinkageVisibilityConverter x:Key="LinkageVisibilityConverter"/>
        <conv:LinkageToImageConverter x:Key="LinkageToImageConverter"/>
        <conv:LinkageToDescriptionConverter x:Key="LinkageToDescriptionConverter"/>
        <conv:LinkageAllowedConverter x:Key="LinkageAllowedConverter"/>
        <conv:SelectedGroupToBoolConverter x:Key="SelectedGroupToBoolConverter"/>
        <conv:SelectedGroupToVisibilityConverter x:Key="SelectedGroupToVisibilityConverter"/>
        <conv:LinkageTypeLocalizationConverter x:Key="LinkageTypeLocalizationConverter"/>

        <!-- ===== Carte principale : accent quand actif, atténuée quand inactif ===== -->
        <Style x:Key="ActiveAwareContainer" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Active}" Value="False">
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Section sans bordure (remplace le style implicite Border qui encadrait chaque zone) -->
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Champ en lecture seule (affichage du nom de la pièce 1) -->
        <Style x:Key="ReadOnlyFieldBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>

        <!-- Même comportement pour ui:TextBox (le style implicite ci-dessus ne s'applique pas aux sous-classes) -->
        <Style TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Active}" Value="False">
                    <Setter Property="IsReadOnly" Value="False"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NumericBoxPointStyle" TargetType="ui:NumberBox" BasedOn="{StaticResource NumericBoxCadPointStyle}">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="True"/>
                            <!-- Aspect "désactivé", mais le contrôle reste interactif -->
                            <Setter Property="Opacity" Value="0.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NumericBoxDirectionStyle" TargetType="ui:NumberBox" BasedOn="{StaticResource NumericBoxCadEdgeStyle}">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="IsReadOnly" Value="False"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                    <Setter Property="IsEnabled" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Active}" Value="False">
                    <Setter Property="IsEnabled" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Conservé pour ToleranceEditor : bordure fine aux couleurs du thème -->
        <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>

        <!-- ================================================================== -->
        <!-- Visibilité par groupe de tolérance (1=N, 2=T1, 3=T2, 4=Rn, 5=Rt1,   -->
        <!-- 6=Rt2). Remplace 18 liaisons Visibility identiques.                 -->
        <!-- ================================================================== -->
        <Style x:Key="TolGroupVisibleBase" TargetType="FrameworkElement">
            <Setter Property="Visibility"
            Value="{Binding DataContext.SelectedToleranceGroup,
                            RelativeSource={RelativeSource AncestorType=localControls:PanelData},
                            Converter={StaticResource SelectedGroupToVisibilityConverter}}"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Active,
                                       RelativeSource={RelativeSource AncestorType=localControls:PanelData}}"
                     Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TolGroup1Visible"
       TargetType="FrameworkElement"
       BasedOn="{StaticResource TolGroupVisibleBase}">
            <Setter Property="Visibility"
            Value="{Binding DataContext.SelectedToleranceGroup,
                            RelativeSource={RelativeSource AncestorType=localControls:PanelData},
                            Converter={StaticResource SelectedGroupToVisibilityConverter},
                            ConverterParameter=1}"/>
        </Style>

        <Style x:Key="TolGroup2Visible"
       TargetType="FrameworkElement"
       BasedOn="{StaticResource TolGroupVisibleBase}">
            <Setter Property="Visibility"
            Value="{Binding DataContext.SelectedToleranceGroup,
                            RelativeSource={RelativeSource AncestorType=localControls:PanelData},
                            Converter={StaticResource SelectedGroupToVisibilityConverter},
                            ConverterParameter=2}"/>
        </Style>

        <Style x:Key="TolGroup3Visible"
       TargetType="FrameworkElement"
       BasedOn="{StaticResource TolGroupVisibleBase}">
            <Setter Property="Visibility"
            Value="{Binding DataContext.SelectedToleranceGroup,
                            RelativeSource={RelativeSource AncestorType=localControls:PanelData},
                            Converter={StaticResource SelectedGroupToVisibilityConverter},
                            ConverterParameter=3}"/>
        </Style>

        <Style x:Key="TolGroup4Visible"
       TargetType="FrameworkElement"
       BasedOn="{StaticResource TolGroupVisibleBase}">
            <Setter Property="Visibility"
            Value="{Binding DataContext.SelectedToleranceGroup,
                            RelativeSource={RelativeSource AncestorType=localControls:PanelData},
                            Converter={StaticResource SelectedGroupToVisibilityConverter},
                            ConverterParameter=4}"/>
        </Style>

        <Style x:Key="TolGroup5Visible"
       TargetType="FrameworkElement"
       BasedOn="{StaticResource TolGroupVisibleBase}">
            <Setter Property="Visibility"
            Value="{Binding DataContext.SelectedToleranceGroup,
                            RelativeSource={RelativeSource AncestorType=localControls:PanelData},
                            Converter={StaticResource SelectedGroupToVisibilityConverter},
                            ConverterParameter=5}"/>
        </Style>

        <Style x:Key="TolGroup6Visible"
       TargetType="FrameworkElement"
       BasedOn="{StaticResource TolGroupVisibleBase}">
            <Setter Property="Visibility"
            Value="{Binding DataContext.SelectedToleranceGroup,
                            RelativeSource={RelativeSource AncestorType=localControls:PanelData},
                            Converter={StaticResource SelectedGroupToVisibilityConverter},
                            ConverterParameter=6}"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="0" ShowGridLines="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== -->
        <!-- Carte principale      -->
        <!-- ===================== -->
        <Border Grid.Column="0"
                Margin="0,0,12,0"
                Style="{StaticResource ActiveAwareContainer}">

            <Grid x:Name="MainGridPanelData" ShowGridLines="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" x:Name="Row0"/>
                    <RowDefinition Height="{Binding ParentViewModel.Row1Height, RelativeSource={RelativeSource AncestorType=localControls:PanelData}}" x:Name="Row1"/>
                    <RowDefinition Height="{Binding ParentViewModel.Row2Height, RelativeSource={RelativeSource AncestorType=localControls:PanelData}}" x:Name="Row2"/>
                    <RowDefinition Height="{Binding ParentViewModel.Row3Height, RelativeSource={RelativeSource AncestorType=localControls:PanelData}}" x:Name="Row3"/>
                    <RowDefinition Height="{Binding ParentViewModel.Row4Height, RelativeSource={RelativeSource AncestorType=localControls:PanelData}}" x:Name="Row4"/>
                    <RowDefinition Height="{Binding ParentViewModel.Row5Height, RelativeSource={RelativeSource AncestorType=localControls:PanelData}}" x:Name="Row5"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="171"/>
                    <ColumnDefinition Width="0"/>
                    <ColumnDefinition Width="*" MinWidth="500"/>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ============ NOM DE LA LIAISON ============ -->
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                        Style="{StaticResource SectionBorderStyle}">
                    <ui:TextBox x:Name="NamePoText"
                                MinWidth="500"
                                MaxHeight="40"
                                HorizontalAlignment="Stretch"
                                TextWrapping="NoWrap"
                                PlaceholderText="{lang:Loc Placeholder_NamePo}"
                                Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>

                <!-- ============ ACTIF + ID ============ -->
                <Border Grid.Row="0" Grid.Column="3"
                        Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Center"
                                         OnContent="" OffContent=""
                                         IsChecked="{Binding Active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <ui:TextBox x:Name="IdText"
                                        MinWidth="50"
                                        IsReadOnly="True"
                                        Text="{Binding Id, Mode=TwoWay}"/>
                            <!-- Modifications non enregistrées (remplace le "*") -->
                            <TextBlock Text="●"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ PIÈCE 1 ============ -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{lang:Loc Part1}" />
                        <Border Style="{StaticResource ReadOnlyFieldBorderStyle}">
                            <TextBlock x:Name="Part1Text"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding ExtremitePartId, Converter={StaticResource IdToNameConverter}, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============ LIAISON ============ -->
                <Border x:Name="Linkage" Grid.Row="2" Grid.Column="0" >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Aide (infobulle image + description) -->
                        <ui:Button x:Name="LinkageInfoButton"
                                   Grid.Row="0" Grid.Column="1"
                                   Width="28" Height="28"
                                   Padding="0"
                                   Margin="0,0,0,4"
                                   Appearance="Transparent"
                                   Cursor="Help"
                                   Icon="{ui:SymbolIcon QuestionCircle24}">
                            <ui:Button.ToolTip>
                                <ToolTip>
                                    <StackPanel Orientation="Horizontal" MaxWidth="820">
                                        <Image Width="200" Height="200" Margin="0,0,8,0" VerticalAlignment="Top"
                                               Source="{Binding PlacementTarget.DataContext.Linkage,
                                                                RelativeSource={RelativeSource AncestorType=ToolTip},
                                                                Converter={StaticResource LinkageToImageConverter}}"/>
                                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Text="{Binding PlacementTarget.DataContext.Linkage,
                                                                  RelativeSource={RelativeSource AncestorType=ToolTip},
                                                                  Converter={StaticResource LinkageToDescriptionConverter}}"/>
                                    </StackPanel>
                                </ToolTip>
                            </ui:Button.ToolTip>
                        </ui:Button>

                        <ComboBox Grid.Row="1" Grid.ColumnSpan="2"
                                  ItemsSource="{Binding AvailableLinkageTypes, ElementName=PanelDataName}"
                                  SelectedValue="{Binding Linkage, Mode=TwoWay}"
                                  SelectedValuePath="Value"
                                  IsEditable="False">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource LinkageTypeLocalizationConverter}">
                                                <Binding Path="Value"/>
                                                <Binding Path="CurrentCulture" Source="{x:Static lang:LocalizationManager.Instance}"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Sélecteur du groupe de tolérance -->
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,8,0,0">
                            <RadioButton GroupName="{Binding Id, StringFormat=ToleranceGroupSelector_{0}}" Content="N"
                                         Style="{StaticResource ToleranceGroupRadioButtonStyle}"
                                         IsEnabled="{Binding Linkage, Converter={StaticResource LinkageAllowedConverter}, ConverterParameter=1}"
                                         IsChecked="{Binding SelectedToleranceGroup, Converter={StaticResource SelectedGroupToBoolConverter}, ConverterParameter=1, Mode=TwoWay}"/>
                            <RadioButton GroupName="{Binding Id, StringFormat=ToleranceGroupSelector_{0}}" Content="T1" Margin="4,0,0,0"
                                         Style="{StaticResource ToleranceGroupRadioButtonStyle}"
                                         IsEnabled="{Binding Linkage, Converter={StaticResource LinkageAllowedConverter}, ConverterParameter=2}"
                                         IsChecked="{Binding SelectedToleranceGroup, Converter={StaticResource SelectedGroupToBoolConverter}, ConverterParameter=2, Mode=TwoWay}"/>
                            <RadioButton GroupName="{Binding Id, StringFormat=ToleranceGroupSelector_{0}}" Content="T2" Margin="4,0,0,0"
                                         Style="{StaticResource ToleranceGroupRadioButtonStyle}"
                                         IsEnabled="{Binding Linkage, Converter={StaticResource LinkageAllowedConverter}, ConverterParameter=3}"
                                         IsChecked="{Binding SelectedToleranceGroup, Converter={StaticResource SelectedGroupToBoolConverter}, ConverterParameter=3, Mode=TwoWay}"/>
                            <RadioButton GroupName="{Binding Id, StringFormat=ToleranceGroupSelector_{0}}" Content="Rn" Margin="4,0,0,0"
                                         Style="{StaticResource ToleranceGroupRadioButtonStyle}"
                                         IsEnabled="{Binding Linkage, Converter={StaticResource LinkageAllowedConverter}, ConverterParameter=4}"
                                         IsChecked="{Binding SelectedToleranceGroup, Converter={StaticResource SelectedGroupToBoolConverter}, ConverterParameter=4, Mode=TwoWay}"/>
                            <RadioButton GroupName="{Binding Id, StringFormat=ToleranceGroupSelector_{0}}" Content="Rt1" Margin="4,0,0,0"
                                         Style="{StaticResource ToleranceGroupRadioButtonStyle}"
                                         IsEnabled="{Binding Linkage, Converter={StaticResource LinkageAllowedConverter}, ConverterParameter=5}"
                                         IsChecked="{Binding SelectedToleranceGroup, Converter={StaticResource SelectedGroupToBoolConverter}, ConverterParameter=5, Mode=TwoWay}"/>
                            <RadioButton GroupName="{Binding Id, StringFormat=ToleranceGroupSelector_{0}}" Content="Rt2" Margin="4,0,0,0"
                                         Style="{StaticResource ToleranceGroupRadioButtonStyle}"
                                         IsEnabled="{Binding Linkage, Converter={StaticResource LinkageAllowedConverter}, ConverterParameter=6}"
                                         IsChecked="{Binding SelectedToleranceGroup, Converter={StaticResource SelectedGroupToBoolConverter}, ConverterParameter=6, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ PIÈCE 2 ============ -->
                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{lang:Loc Part2}" />
                        <ComboBox x:Name="Part2Text"
                                  VerticalAlignment="Top"
                                  MinWidth="100"
                                  IsEditable="False"
                                  DisplayMemberPath="NamePart"
                                  SelectedValuePath="Id"
                                  ItemsSource="{Binding ParentViewModel.Parts, RelativeSource={RelativeSource AncestorType=localControls:PanelData}}"
                                  Text="{Binding OriginePartId, Converter={StaticResource IdToNameConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValue="{Binding OriginePartId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- ÉDITEURS DE TOLÉRANCE (3 par groupe : Extrémité /     -->
                <!-- Intermédiaire / Origine), un seul groupe visible.     -->
                <!-- ==================================================== -->

                <!-- Groupe N -->
                <localTol:ToleranceEditor Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3"
                           Style="{StaticResource TolGroup1Visible}"
                           DataContext="{Binding N.Extremity}"
                           Active="{Binding DataContext.Active, ElementName=PanelDataName}"
                           PlaceholderName="{lang:Loc Placeholder_Tol1Name}"
                           PlaceholderDescription="{lang:Loc Placeholder_Tol1Desc}"
                           PlaceholderTolerance="{lang:Loc Placeholder_Tol1}"/>
                <localTol:ToleranceEditor Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3"
                           Style="{StaticResource TolGroup1Visible}"
                           DataContext="{Binding N.Intermediate}"
                           Active="{Binding DataContext.Active, ElementName=PanelDataName}"
                           PlaceholderName="{lang:Loc Placeholder_TolIntName}"
                           PlaceholderDescription="{lang:Loc Placeholder_TolIntDesc}"
                           PlaceholderTolerance="{lang:Loc Placeholder_TolInt}"/>
                <localTol:ToleranceEditor Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="3"
                           Style="{StaticResource TolGroup1Visible}"
                           DataContext="{Binding N.Origin}"
                           Active="{Binding DataContext.Active, ElementName=PanelDataName}"
                           PlaceholderName="{lang:Loc Placeholder_Tol2Name}"
                           PlaceholderDescription="{lang:Loc Placeholder_Tol2Desc}"
                           PlaceholderTolerance="{lang:Loc Placeholder_Tol2}"/>

                <!-- Groupe T1 -->
                <localTol:ToleranceEditor Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3"
                           Style="{StaticResource TolGroup2Visible}"
                           DataContext="{Binding T1.Extremity}"
                           Active="{Binding DataContext.Active, ElementName=PanelDataName}"
                           PlaceholderName="{lang:Loc Placeholder_Tol1Name}"
                           PlaceholderDescription="{lang:Loc Placeholder_Tol1Desc}"
                           PlaceholderTolerance="{lang:Loc Placeholder_Tol1}"/>
                <localTol:ToleranceEditor Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3"
                           Style="{StaticResource TolGroup2Visible}"
                           DataContext="{Binding T1.Intermediate}"
                           Active="{Binding DataContext.Active, ElementName=PanelDataName}"
                           PlaceholderName="{lang:Loc Placeholder_TolIntName}"
                           PlaceholderDescription="{lang:Loc Placeholder_TolIntDesc}"
                           PlaceholderTolerance="{lang:Loc Placeholder_TolInt}"/>
                <localTol:ToleranceEditor Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="3"
                           Style="{StaticResource TolGroup2Visible}"
                           DataContext="{Binding T1.Origin}"
                           Active="{Binding DataContext.Active, ElementName=PanelDataName}"
                           PlaceholderName="{lang:Loc Placeholder_Tol2Name}"
                           PlaceholderDescription="{lang:Loc Placeholder_Tol2Desc}"
                           PlaceholderTolerance="{lang:Loc Placeholder_Tol2}"/>

                <!-- Groupe T2 -->
                <localTol:ToleranceEditor Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3"
                           Style="{StaticResource TolGroup3Visible}"
                           DataContext="{Binding T2.Extremity}"
                           Active="{Binding DataContext.Active, ElementName=PanelDataName}"
                           PlaceholderName="{lang:Loc Placeholder_Tol1Name}"
                           PlaceholderDescription="{lang:Loc Placeholder_Tol1Desc}"
                           PlaceholderTolerance="{lang:Loc Placeholder_Tol1}"/>
                <localTol:ToleranceEditor Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3"
                           Style="{StaticResource TolGroup3Visible}"
                           DataContext="{Binding T2.Intermediate}"
                           Active="{Binding DataContext.Active, ElementName=PanelDataName}"
                           PlaceholderName="{lang:Loc Placeholder_TolIntName}"
                           PlaceholderDescription="{lang:Loc Placeholder_TolIntDesc}"
                           PlaceholderTolerance="{lang:Loc Placeholder_TolInt}"/>
                <localTol:ToleranceEditor Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="3"
                           Style="{StaticResource TolGroup3Visible}"
                           DataContext="{Binding T2.Origin}"
                           Active="{Binding DataContext.Active, ElementName=PanelDataName}"
                           PlaceholderName="{lang:Loc Placeholder_Tol2Name}"
                           PlaceholderDescription="{lang:Loc Placeholder_Tol2Desc}"
                           PlaceholderTolerance="{lang:Loc Placeholder_Tol2}"/>

                <!-- Groupe Rn -->
                <localTol:ToleranceEditor Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3"
                           Style="{StaticResource TolGroup4Visible}"
                           DataContext="{Binding Rn.Extremity}"
                           Active="{Binding DataContext.Active, ElementName=PanelDataName}"
                           PlaceholderName="{lang:Loc Placeholder_Tol1Name}"
                           PlaceholderDescription="{lang:Loc Placeholder_Tol1Desc}"
                           PlaceholderTolerance="{lang:Loc Placeholder_Tol1}"/>
                <localTol:ToleranceEditor Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3"
                           Style="{StaticResource TolGroup4Visible}"
                           DataContext="{Binding Rn.Intermediate}"
                           Active="{Binding DataContext.Active, ElementName=PanelDataName}"
                           PlaceholderName="{lang:Loc Placeholder_TolIntName}"
                           PlaceholderDescription="{lang:Loc Placeholder_TolIntDesc}"
                           PlaceholderTolerance="{lang:Loc Placeholder_TolInt}"/>
                <localTol:ToleranceEditor Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="3"
                           Style="{StaticResource TolGroup4Visible}"
                           DataContext="{Binding Rn.Origin}"
                           Active="{Binding DataContext.Active, ElementName=PanelDataName}"
                           PlaceholderName="{lang:Loc Placeholder_Tol2Name}"
                           PlaceholderDescription="{lang:Loc Placeholder_Tol2Desc}"
                           PlaceholderTolerance="{lang:Loc Placeholder_Tol2}"/>

                <!-- Groupe Rt1 -->
                <localTol:ToleranceEditor Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3"
                           Style="{StaticResource TolGroup5Visible}"
                           DataContext="{Binding RT1.Extremity}"
                           Active="{Binding DataContext.Active, ElementName=PanelDataName}"
                           PlaceholderName="{lang:Loc Placeholder_Tol1Name}"
                           PlaceholderDescription="{lang:Loc Placeholder_Tol1Desc}"
                           PlaceholderTolerance="{lang:Loc Placeholder_Tol1}"/>
                <localTol:ToleranceEditor Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3"
                           Style="{StaticResource TolGroup5Visible}"
                           DataContext="{Binding RT1.Intermediate}"
                           Active="{Binding DataContext.Active, ElementName=PanelDataName}"
                           PlaceholderName="{lang:Loc Placeholder_TolIntName}"
                           PlaceholderDescription="{lang:Loc Placeholder_TolIntDesc}"
                           PlaceholderTolerance="{lang:Loc Placeholder_TolInt}"/>
                <localTol:ToleranceEditor Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="3"
                           Style="{StaticResource TolGroup5Visible}"
                           DataContext="{Binding RT1.Origin}"
                           Active="{Binding DataContext.Active, ElementName=PanelDataName}"
                           PlaceholderName="{lang:Loc Placeholder_Tol2Name}"
                           PlaceholderDescription="{lang:Loc Placeholder_Tol2Desc}"
                           PlaceholderTolerance="{lang:Loc Placeholder_Tol2}"/>

                <!-- Groupe Rt2 -->
                <localTol:ToleranceEditor Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3"
                           Style="{StaticResource TolGroup6Visible}"
                           DataContext="{Binding RT2.Extremity}"
                           Active="{Binding DataContext.Active, ElementName=PanelDataName}"
                           PlaceholderName="{lang:Loc Placeholder_Tol1Name}"
                           PlaceholderDescription="{lang:Loc Placeholder_Tol1Desc}"
                           PlaceholderTolerance="{lang:Loc Placeholder_Tol1}"/>
                <localTol:ToleranceEditor Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3"
                           Style="{StaticResource TolGroup6Visible}"
                           DataContext="{Binding RT2.Intermediate}"
                           Active="{Binding DataContext.Active, ElementName=PanelDataName}"
                           PlaceholderName="{lang:Loc Placeholder_TolIntName}"
                           PlaceholderDescription="{lang:Loc Placeholder_TolIntDesc}"
                           PlaceholderTolerance="{lang:Loc Placeholder_TolInt}"/>
                <localTol:ToleranceEditor Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="3"
                           Style="{StaticResource TolGroup6Visible}"
                           DataContext="{Binding RT2.Origin}"
                           Active="{Binding DataContext.Active, ElementName=PanelDataName}"
                           PlaceholderName="{lang:Loc Placeholder_Tol2Name}"
                           PlaceholderDescription="{lang:Loc Placeholder_Tol2Desc}"
                           PlaceholderTolerance="{lang:Loc Placeholder_Tol2}"/>

                <!-- ============ COORDONNÉES (point + direction) ============ -->
                <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4"
                        Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{lang:Loc Coordinate}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Point -->
                            <Grid Grid.Column="0" Margin="0,0,8,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{lang:Loc Point}" Grid.ColumnSpan="3"
                                           />

                                <ui:NumberBox x:Name="PointXText" Grid.Row="1" Grid.Column="0" Margin="0,0,4,0"
                                         Style="{StaticResource NumericBoxPointStyle}"
                                         PlaceholderText="{lang:Loc Placeholder_PointX}" 
                                         Value="{Binding CoordX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ui:NumberBox.CommandBindings>
                                        <CommandBinding Command="{x:Static cad:CadCommands.PickPoint}"
                                                        Executed="PickPointMenuItem_Executed"/>
                                    </ui:NumberBox.CommandBindings>
                                </ui:NumberBox>
                                <ui:NumberBox x:Name="PointYText" Grid.Row="1" Grid.Column="1" Margin="4,0"
                                         Style="{DynamicResource NumericBoxPointStyle}"
                                         PlaceholderText="{lang:Loc Placeholder_PointY}"
                                         Value="{Binding CoordY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ui:NumberBox.CommandBindings>
                                        <CommandBinding Command="{x:Static cad:CadCommands.PickPoint}"
                                                        Executed="PickPointMenuItem_Executed"/>
                                    </ui:NumberBox.CommandBindings>
                                </ui:NumberBox>
                                <ui:NumberBox x:Name="PointZText" Grid.Row="1" Grid.Column="2" Margin="4,0,0,0"
                                         Style="{DynamicResource NumericBoxPointStyle}"
                                         PlaceholderText="{lang:Loc Placeholder_PointZ}"
                                         Value="{Binding CoordZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ui:NumberBox.CommandBindings>
                                        <CommandBinding Command="{x:Static cad:CadCommands.PickPoint}"
                                            Executed="PickPointMenuItem_Executed"/>
                                    </ui:NumberBox.CommandBindings>
                                </ui:NumberBox>
                            </Grid>

                            <!-- Direction -->
                            <Grid Grid.Column="1" Margin="8,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{lang:Loc Direction}" Grid.ColumnSpan="3"
                                           />

                                <ui:NumberBox x:Name="DirectionXText" Grid.Row="1" Grid.Column="0" Margin="0,0,4,0"
                                         Style="{DynamicResource NumericBoxDirectionStyle}"
                                         PlaceholderText="{lang:Loc Placeholder_DirX}"
                                         Value="{Binding CoordU, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ui:NumberBox.CommandBindings>
                                        <CommandBinding Command="{x:Static cad:CadCommands.PickEdge}"
                                                        Executed="PickEdgeMenuItem_Executed"/>
                                    </ui:NumberBox.CommandBindings>
                                </ui:NumberBox>
                                <ui:NumberBox x:Name="DirectionYText" Grid.Row="1" Grid.Column="1" Margin="4,0"
                                         Style="{DynamicResource NumericBoxDirectionStyle}"
                                         PlaceholderText="{lang:Loc Placeholder_DirY}"
                                         Value="{Binding CoordV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ui:NumberBox.CommandBindings>
                                        <CommandBinding Command="{x:Static cad:CadCommands.PickEdge}"
                                                        Executed="PickEdgeMenuItem_Executed"/>
                                    </ui:NumberBox.CommandBindings>
                                </ui:NumberBox>
                                <ui:NumberBox x:Name="DirectionZText" Grid.Row="1" Grid.Column="2" Margin="4,0,0,0"
                                         Style="{DynamicResource NumericBoxDirectionStyle}"
                                         PlaceholderText="{lang:Loc Placeholder_DirZ}"
                                         Value="{Binding CoordW, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ui:NumberBox.CommandBindings>
                                        <CommandBinding Command="{x:Static cad:CadCommands.PickEdge}"
                                                        Executed="PickEdgeMenuItem_Executed"/>
                                    </ui:NumberBox.CommandBindings>
                                </ui:NumberBox>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ COMMENTAIRE ============ -->
                <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4"
                        Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{lang:Loc Comment}" />
                        <ui:TextBox x:Name="CommentText"
                                    MinWidth="50"
                                    MinHeight="60"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"
                                    VerticalContentAlignment="Top"
                                    PlaceholderText="{lang:Loc Placeholder_Comment}"
                                    Text="{Binding Commentaire, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- ===================== -->
        <!-- Boutons d'action      -->
        <!-- ===================== -->
        <StackPanel Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    MinWidth="130">

            <ui:Button HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Left"
                       Margin="0,0,0,8"
                       Appearance="Primary"
                       Icon="{ui:SymbolIcon Save24}"
                       Content="{lang:Loc Save}"
                       Command="{Binding DataContext.SavePanelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                       CommandParameter="{Binding}"/>

            <ui:Button HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Left"
                       Margin="0,0,0,8"
                       Appearance="Danger"
                       Icon="{ui:SymbolIcon Delete24}"
                       Content="{lang:Loc Deleted}"
                       Command="{Binding DataContext.DeletePanelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                       CommandParameter="{Binding}"/>

            <ui:Button HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Left"
                       Icon="{ui:SymbolIcon Eraser24}"
                       Content="{lang:Loc Clear}"
                       Command="{Binding DataContext.ClearPanelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                       CommandParameter="{Binding}"/>
        </StackPanel>

    </Grid>
</UserControl>
