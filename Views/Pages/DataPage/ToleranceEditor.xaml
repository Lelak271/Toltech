<UserControl x:Class="Toltech.App.Views.Pages.DataPage.ToleranceEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Toltech.App.Views.Pages.DataPage"
             xmlns:conv="clr-namespace:Toltech.App.Converters"
             xmlns:behaviors="clr-namespace:Toltech.App.Behaviors"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="120"
             d:DesignWidth="400">

    <!-- ====================================================== -->
    <!-- Ressources locales                                     -->
    <!-- ====================================================== -->

    <UserControl.Resources>

        <conv:IdToNameConverter x:Key="IdToNameConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Style commun des TextBox -->
        <Style x:Key="ToleranceEditorTextBoxStyle"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource {x:Type TextBox}}">

            <Setter Property="Background"
                    Value="{DynamicResource ControlFillColorDefaultBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextFillColorPrimaryBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="8,5"/>

            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Style.Triggers>

                <DataTrigger
                    Binding="{Binding Active,
                              RelativeSource={RelativeSource AncestorType={x:Type local:ToleranceEditor}}}"
                    Value="True">

                    <Setter Property="IsReadOnly" Value="False"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                    <Setter Property="IsEnabled" Value="True"/>

                    <Setter Property="Background"
                            Value="{DynamicResource ControlFillColorSecondaryBrush}"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>


        <!-- Style des champs numériques -->
        <Style x:Key="NumEditTextBoxStyle"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource NumericTextBoxStyle}">

            <Setter Property="Background"
                    Value="{DynamicResource ControlFillColorDefaultBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextFillColorPrimaryBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>

            <Setter Property="Padding"
                    Value="8,5"/>

            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalAlignment"
                    Value="Stretch"/>

            <Style.Triggers>

                <DataTrigger
                    Binding="{Binding Active,
                              RelativeSource={RelativeSource AncestorType={x:Type local:ToleranceEditor}}}"
                    Value="True">

                    <Setter Property="IsReadOnly" Value="False"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                    <Setter Property="IsEnabled" Value="True"/>

                    <Setter Property="Background"
                            Value="{DynamicResource ControlFillColorSecondaryBrush}"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>


        <!-- Style du champ de tolérance -->
        <Style x:Key="TolTextBoxStyle"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource ToleranceTextBoxStyle}">

            <Setter Property="Background"
                    Value="{DynamicResource ControlFillColorDefaultBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextFillColorPrimaryBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="6,4"/>

            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalAlignment"
                    Value="Stretch"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Style.Triggers>

                <DataTrigger
                    Binding="{Binding Active,
                              RelativeSource={RelativeSource AncestorType={x:Type local:ToleranceEditor}}}"
                    Value="True">

                    <Setter Property="IsReadOnly" Value="False"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                    <Setter Property="IsEnabled" Value="True"/>

                    <Setter Property="Background"
                            Value="{DynamicResource ControlFillColorSecondaryBrush}"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>


        <!-- Style de la case à cocher -->
        <Style TargetType="{x:Type CheckBox}"
               BasedOn="{StaticResource {x:Type CheckBox}}">

            <Setter Property="IsEnabled" Value="False"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding Active}" Value="True">
                    <Setter Property="IsEnabled" Value="True"/>
                </DataTrigger>

            </Style.Triggers>

        </Style>


        <!-- Bordure du composant -->
        <Style x:Key="ToleranceEditorBorderStyle"
               TargetType="{x:Type Border}">

            <Setter Property="BorderBrush"
                    Value="{DynamicResource CardStrokeColorDefaultBrush}"/>

            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>

            <Setter Property="Background"
                    Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>

        </Style>

    </UserControl.Resources>


    <!-- ====================================================== -->
    <!-- Menu contextuel                                        -->
    <!-- ====================================================== -->

    <UserControl.ContextMenu>

        <ContextMenu>

            <MenuItem Header="Select closing tolerance..."
                      Click="SelectClosingTolerance_Click"/>

        </ContextMenu>

    </UserControl.ContextMenu>


    <!-- ====================================================== -->
    <!-- Contenu                                                -->
    <!-- ====================================================== -->

    <Border Margin="4"
            Padding="8"
            Style="{StaticResource ToleranceEditorBorderStyle}"
            >

        <Grid VerticalAlignment="Center" >

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>


            <!-- Champ de nom -->

            <ui:TextBox Grid.Row="0"
                     Grid.Column="0"
                     Margin="0,0,8,0"
                     PlaceholderText="{Binding PlaceholderName,
                      RelativeSource={RelativeSource AncestorType={x:Type local:ToleranceEditor}}}"
                     Text="{Binding Name,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"
                     />

            <!-- Lien vers la base de données -->

            <CheckBox Grid.Row="0"
                      Grid.Column="1"
                      Margin="0,0,0,0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsEnabled="True"
                      IsChecked="{Binding UseDatabase, Mode=TwoWay}"
                      ToolTip="Use tolerance from database">

                <Image Source="/Asset/Logo_DB_tol.png"
                       Width="22"
                       Height="22"
                       Stretch="Uniform"/>

            </CheckBox>


            <!-- Description -->

            <ui:TextBox Grid.Row="1"
                     Grid.Column="0"
                     Margin="0,6,8,0"
                     TextWrapping="Wrap"
                     PlaceholderText="{Binding PlaceholderDescription,
                         RelativeSource={RelativeSource AncestorType={x:Type local:ToleranceEditor}}}"
                     Text="{Binding Description,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"
                     />


            <!-- Valeur de tolérance -->

            <ui:TextBox Grid.Row="1"
                     Grid.Column="1"
                     Margin="0,6,0,0"
                     Text="{Binding Value,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{Binding PlaceholderTolerance,
                         RelativeSource={RelativeSource AncestorType={x:Type local:ToleranceEditor}}}"/>

        </Grid>

    </Border>

</UserControl>