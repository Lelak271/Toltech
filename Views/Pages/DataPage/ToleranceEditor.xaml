<UserControl x:Class="Toltech.App.Views.Pages.DataPage.ToleranceEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Toltech.App.Views.Pages.DataPage"
             xmlns:conv="clr-namespace:Toltech.App.Converters"
             xmlns:behaviors="clr-namespace:Toltech.App.Behaviors"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="120"
             d:DesignWidth="400">

    <!-- ====================================================== -->
    <!-- Ressources locales                                     -->
    <!-- ====================================================== -->

    <UserControl.Resources>

        <conv:IdToNameConverter x:Key="IdToNameConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Style de la case à cocher -->
        <Style TargetType="{x:Type CheckBox}"
               BasedOn="{StaticResource {x:Type CheckBox}}">

            <Setter Property="IsEnabled" Value="False"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding Active}" Value="True">
                    <Setter Property="IsEnabled" Value="True"/>
                </DataTrigger>

            </Style.Triggers>

        </Style>


        <!-- Bordure du composant -->
        <Style x:Key="ToleranceEditorBorderStyle"
               TargetType="{x:Type Border}">

            <Setter Property="BorderBrush"
                    Value="{DynamicResource CardStrokeColorDefaultBrush}"/>

            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>

            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>

        </Style>

    </UserControl.Resources>


    <!-- ====================================================== -->
    <!-- Menu contextuel                                        -->
    <!-- ====================================================== -->

    <UserControl.ContextMenu>

        <ContextMenu>

            <MenuItem Header="Select closing tolerance..."
                      Click="SelectClosingTolerance_Click"/>

        </ContextMenu>

    </UserControl.ContextMenu>


    <!-- ====================================================== -->
    <!-- Contenu                                                -->
    <!-- ====================================================== -->

    <Border Margin="4"
            Padding="8"
            Style="{StaticResource ToleranceEditorBorderStyle}"
            >

        <Grid VerticalAlignment="Center" ShowGridLines="False" >

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>


            <!-- Champ de nom -->

            <ui:TextBox  
                        Grid.Row="0"
                     Grid.Column="0"
                     Margin="0,0,8,0"
                     PlaceholderText="{Binding PlaceholderName,
                      RelativeSource={RelativeSource AncestorType={x:Type local:ToleranceEditor}}}"
                     Text="{Binding Name,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"
                     />

            <!-- Lien vers la base de données -->

            <CheckBox Grid.Row="0"
                     Grid.Column="1"
                      x:Name="DatabaseCheckBox" 
                          MaxWidth="5"
                          IsEnabled="True"
                          IsChecked="{Binding UseDatabase, 
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="Use tolerance from database">

                <Image Source="/Asset/Logo_DB_tol.png"
                       Width="22"
                       Height="22"
                       Stretch="Uniform"/>

            </CheckBox>
                <!--Text="{Binding Id, Mode=TwoWay}"-->
            <ui:TextBox Grid.Row="0"
                     Grid.Column="2" 
                        Text="{Binding Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            MinWidth="45"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsReadOnly="True"
                            Visibility="{Binding IsChecked,
                                         ElementName=DatabaseCheckBox,
                                         Converter={StaticResource BoolToVisibilityConverter}}"
                             ContextMenu="{x:Null}" />

                <!-- Description -->

            <ui:TextBox Grid.Row="1"
                     Grid.Column="0"
                     Margin="0,6,8,0"
                     TextWrapping="Wrap"
                     PlaceholderText="{Binding PlaceholderDescription,
                         RelativeSource={RelativeSource AncestorType={x:Type local:ToleranceEditor}}}"
                     Text="{Binding Description,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"
                     />


            <!-- Valeur de tolérance -->

            <ui:NumberBox Grid.Row="1"
                     Grid.Column="1" Grid.ColumnSpan="2"
                     Margin="20,6,20,0"
                          SpinButtonPlacementMode="Hidden"
                     Value="{Binding Value,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{Binding PlaceholderTolerance,
                         RelativeSource={RelativeSource AncestorType={x:Type local:ToleranceEditor}}}"/>

        </Grid>

    </Border>

</UserControl>