<UserControl x:Class="Toltech.App.FrontEnd.Controls.PanelReqs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:behaviors="clr-namespace:Toltech.App.Behaviors"
             xmlns:models="clr-namespace:Toltech.App.Models"
             xmlns:conv="clr-namespace:Toltech.App.Converters"
             xmlns:localControls="clr-namespace:Toltech.App.FrontEnd.Controls"
             xmlns:localTol="clr-namespace:Toltech.App.Views.Pages.DataPage"
             xmlns:lang="clr-namespace:Toltech.App.Resources.Lang"
             xmlns:cad="clr-namespace:Toltech.App.Services.CAD"
             mc:Ignorable="d"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Focusable="True">

    <!-- ===================== -->
    <!-- Ressources et styles  -->
    <!-- ===================== -->
    <UserControl.Resources>

        <conv:IdToNameConverter x:Key="IdToNameConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- ===== Carte principale : accent quand actif, atténuée quand inactif ===== -->
        <Style x:Key="ActiveAwareContainer" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Section sans bordure (remplace le style implicite Border qui encadrait chaque zone) -->
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style  TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>

        <!-- Même comportement pour ui:TextBox (le style implicite ci-dessus ne s'applique pas aux sous-classes) -->
        <Style TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter Property="IsReadOnly" Value="False"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NumericBoxPointStyle" TargetType="ui:NumberBox" BasedOn="{StaticResource NumericBoxCadPointStyle}">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="True"/>
                    <!-- Aspect "désactivé", mais le contrôle reste interactif -->
                    <Setter Property="Opacity" Value="0.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NumericBoxDirectionStyle" TargetType="ui:NumberBox" BasedOn="{StaticResource NumericBoxCadEdgeStyle}">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="IsReadOnly" Value="False"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                    <Setter Property="IsEnabled" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter Property="IsEnabled" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Conservé pour ToleranceEditor : bordure fine aux couleurs du thème -->
        <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="0" ShowGridLines="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== -->
        <!-- Carte principale      -->
        <!-- ===================== -->
        <Border Grid.Column="0"
                Margin="0,0,12,0"
                Style="{StaticResource ActiveAwareContainer}">

            <Grid x:Name="MainGridPanelReqs" ShowGridLines="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" x:Name="Row0"/>
                    <RowDefinition Height="{Binding ParentViewModel.Row1Height, RelativeSource={RelativeSource AncestorType=localControls:PanelReqs}}" x:Name="Row1"/>
                    <RowDefinition Height="{Binding ParentViewModel.Row2Height, RelativeSource={RelativeSource AncestorType=localControls:PanelReqs}}" x:Name="Row2"/>
                    <RowDefinition Height="{Binding ParentViewModel.Row3Height, RelativeSource={RelativeSource AncestorType=localControls:PanelReqs}}" x:Name="Row3"/>
                    <RowDefinition Height="{Binding ParentViewModel.Row4Height, RelativeSource={RelativeSource AncestorType=localControls:PanelReqs}}" x:Name="Row4"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="171"/>
                    <ColumnDefinition Width="0"/>
                    <ColumnDefinition Width="*" MinWidth="500"/>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ============ NOM DE LA EXIGENCE ============ -->
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                        Style="{StaticResource SectionBorderStyle}">
                    <ui:TextBox x:Name="NameReqText"
                                MinWidth="500"
                                MaxHeight="40"
                                HorizontalAlignment="Stretch"
                                TextWrapping="NoWrap"
                                PlaceholderText="{lang:Loc Placeholder_NameReq}"
                                Text="{Binding NameReq, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>

                <!-- ============ ACTIF + ID ============ -->
                <Border Grid.Row="0" Grid.Column="3"
                        Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Center"
                                         OnContent="" OffContent=""
                                         IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <ui:TextBox x:Name="IdReqText"
                                        MinWidth="50"
                                        IsReadOnly="True"
                                        Text="{Binding Id_req, Mode=TwoWay}"/>
                            <!-- Modifications non enregistrées (remplace le "*") -->
                            <TextBlock Text="●"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ PIÈCE 1 ============ -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{lang:Loc Part1}" />
                        <ComboBox x:Name="Part1Text"
                                  VerticalAlignment="Top"
                                  MinWidth="100"
                                  IsEditable="False"
                                  DisplayMemberPath="NamePart"
                                  SelectedValuePath="Id"
                                  ItemsSource="{Binding ParentViewModel.Parts, RelativeSource={RelativeSource AncestorType=localControls:PanelReqs}}"
                                  SelectedValue="{Binding PartReq1Id, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                </Border>

                <!-- Groupe 1 -->
                <localTol:ToleranceEditor Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3"
                           DataContext="{Binding Basic.Extremity}"
                           Active="{Binding DataContext.IsActive, ElementName=PanelDataName}"
                           PlaceholderName="{lang:Loc Placeholder_Tol1Name}"
                           PlaceholderDescription="{lang:Loc Placeholder_Tol1Desc}"
                           PlaceholderTolerance="{lang:Loc Placeholder_Tol1}"/>
                <!-- Groupe2 -->
                <localTol:ToleranceEditor Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3"
                           DataContext="{Binding Basic.Origin}"
                           Active="{Binding DataContext.IsActive, ElementName=PanelDataName}"
                           PlaceholderName="{lang:Loc Placeholder_Tol2Name}"
                           PlaceholderDescription="{lang:Loc Placeholder_Tol2Desc}"
                           PlaceholderTolerance="{lang:Loc Placeholder_Tol2}"/>
                

                <!-- ============ PIÈCE 2 ============ -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{lang:Loc Part2}" />
                        <ComboBox x:Name="Part2Text"
                                  VerticalAlignment="Top"
                                  MinWidth="100"
                                  IsEditable="False"
                                  DisplayMemberPath="NamePart"
                                  SelectedValuePath="Id"
                                  ItemsSource="{Binding ParentViewModel.Parts, RelativeSource={RelativeSource AncestorType=localControls:PanelReqs}}"
                                  SelectedValue="{Binding PartReq2Id, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                </Border>




                <!-- ============ COORDONNÉES (point + direction) ============ -->
                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
                        Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{lang:Loc Coordinate}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Point -->
                            <Grid Grid.Column="0" Margin="0,0,8,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{lang:Loc Point}" Grid.ColumnSpan="3"
                                           />

                                <ui:NumberBox x:Name="PointX" Grid.Row="1" Grid.Column="0" Margin="0,0,4,0"
                                              HorizontalContentAlignment="Center"
                                              Style="{StaticResource NumericBoxPointStyle}"
                                              PlaceholderText="{lang:Loc Placeholder_PointX}"
                                              Value="{Binding CoordX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ui:NumberBox.CommandBindings>
                                        <CommandBinding Command="{x:Static cad:CadCommands.PickPoint}"
                                        Executed="PickPointMenuItem_Executed"/>
                                    </ui:NumberBox.CommandBindings>
                                </ui:NumberBox>
                                <ui:NumberBox x:Name="PointY" Grid.Row="1" Grid.Column="1" Margin="4,0"
                                              HorizontalContentAlignment="Center"
                                              Style="{StaticResource NumericBoxPointStyle}"
                                              PlaceholderText="{lang:Loc Placeholder_PointY}"
                                              Value="{Binding CoordY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ui:NumberBox.CommandBindings>
                                        <CommandBinding Command="{x:Static cad:CadCommands.PickPoint}"
                                        Executed="PickPointMenuItem_Executed"/>
                                    </ui:NumberBox.CommandBindings>
                                </ui:NumberBox>
                                <ui:NumberBox x:Name="PointZ" Grid.Row="1" Grid.Column="2" Margin="4,0,0,0"
                                              HorizontalContentAlignment="Center"
                                              Style="{StaticResource NumericBoxPointStyle}"
                                              PlaceholderText="{lang:Loc Placeholder_PointZ}"
                                              Value="{Binding CoordZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ui:NumberBox.CommandBindings>
                                        <CommandBinding Command="{x:Static cad:CadCommands.PickPoint}"
                                        Executed="PickPointMenuItem_Executed"/>
                                    </ui:NumberBox.CommandBindings>
                                </ui:NumberBox>
                            </Grid>

                            <!-- Direction -->
                            <Grid Grid.Column="1" Margin="8,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{lang:Loc Direction}" Grid.ColumnSpan="3"
                                           />

                                <ui:NumberBox x:Name="DirU" Grid.Row="1" Grid.Column="0" Margin="0,0,4,0"
                                              HorizontalContentAlignment="Center"
                                              Style="{StaticResource NumericBoxDirectionStyle}"
                                              PlaceholderText="{lang:Loc Placeholder_DirX}"
                                              Value="{Binding CoordU, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ui:NumberBox.CommandBindings>
                                        <CommandBinding Command="{x:Static cad:CadCommands.PickEdge}"
                                                        Executed="PickEdgeMenuItem_Executed"/>
                                    </ui:NumberBox.CommandBindings>
                                </ui:NumberBox>
                                <ui:NumberBox x:Name="DirV" Grid.Row="1" Grid.Column="1" Margin="4,0"
                                              HorizontalContentAlignment="Center"
                                              Style="{StaticResource NumericBoxDirectionStyle}"
                                              PlaceholderText="{lang:Loc Placeholder_DirY}"
                                              Value="{Binding CoordV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ui:NumberBox.CommandBindings>
                                        <CommandBinding Command="{x:Static cad:CadCommands.PickEdge}"
                                                        Executed="PickEdgeMenuItem_Executed"/>
                                    </ui:NumberBox.CommandBindings>
                                </ui:NumberBox>
                                <ui:NumberBox x:Name="DirW" Grid.Row="1" Grid.Column="2" Margin="4,0,0,0"
                                              HorizontalContentAlignment="Center"
                                              Style="{StaticResource NumericBoxDirectionStyle}"
                                              PlaceholderText="{lang:Loc Placeholder_DirZ}"
                                              Value="{Binding CoordW, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ui:NumberBox.CommandBindings>
                                        <CommandBinding Command="{x:Static cad:CadCommands.PickEdge}"
                                                        Executed="PickEdgeMenuItem_Executed"/>
                                    </ui:NumberBox.CommandBindings>
                                </ui:NumberBox>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ COMMENTAIRE ============ -->
                <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4"
                        Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{lang:Loc Comment}" />
                        <ui:TextBox x:Name="CommentText"
                                    MinWidth="50"
                                    MinHeight="60"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"
                                    VerticalContentAlignment="Top"
                                    PlaceholderText="{lang:Loc Placeholder_Comment}"
                                    Text="{Binding Commentaire, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- ===================== -->
        <!-- Boutons d'action      -->
        <!-- ===================== -->
        <StackPanel Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    MinWidth="130">

            <ui:Button HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Left"
                       Margin="0,0,0,8"
                       Appearance="Primary"
                       Icon="{ui:SymbolIcon Save24}"
                       Content="{lang:Loc Save}"
                       Command="{Binding DataContext.SaveUniqueCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                       CommandParameter="{Binding}"/>

            <ui:Button HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Left"
                       Margin="0,0,0,8"
                       Appearance="Danger"
                       Icon="{ui:SymbolIcon Delete24}"
                       Content="{lang:Loc Deleted}"
                       Command="{Binding DataContext.RemoveUniqueCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                       CommandParameter="{Binding}"/>

            <ui:Button HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Left"
                       Icon="{ui:SymbolIcon Eraser24}"
                       Content="{lang:Loc Clear}"
                       Command="{Binding DataContext.ClearPanelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                       CommandParameter="{Binding}"/>
        </StackPanel>

    </Grid>
</UserControl>
