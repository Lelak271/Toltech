<UserControl x:Class="Toltech.App.Views.PageReq"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Toltech.App.Views"
      xmlns:racine="clr-namespace:Toltech.App"
      xmlns:models="clr-namespace:Toltech.App.Models"
      xmlns:localControls="clr-namespace:Toltech.App.FrontEnd.Controls"
      xmlns:mainVM="clr-namespace:Toltech.App.Resources"
      xmlns:conv="clr-namespace:Toltech.App.Converters"
      xmlns:lang="clr-namespace:Toltech.App.Resources.Lang"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" 
      Loaded="Page_Loaded"
      x:Name="ReqPage"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <UserControl.Resources>
        <conv:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter"/>
        <conv:EnumEqualsToVisibilityConverter x:Key="EnumEqualsToVisibilityConverter"/>
        <conv:BooleanToImageConverter x:Key="EyeConverter"
                                      TrueImage="pack://application:,,,/Asset/Graphe.png"
                                      FalseImage="pack://application:,,,/Asset/eyehide.png"/>

        
    </UserControl.Resources>

    <DockPanel LastChildFill="True" >

        <!-- ======================= Arborescence (gauche, largeur fixe) ======================= -->
        <Border DockPanel.Dock="Left" Style="{StaticResource PageCardStyle}">
            <Grid Name="GridTreeViewReq" Width="250" >
                <localControls:TreeViewAreaV3 x:Name="TreeViewReq" DataContext="{Binding TreeVM}"/>
            </Grid>
        </Border>

        <!-- ======================= Zone principale ======================= -->
        <Border Style="{StaticResource PageCardStyle}" Margin="12,0,0,0">
            <Grid  x:Name="MainGridReq"   ShowGridLines="False" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ===================== EN-TÊTE ===================== -->
                <Border x:Name="HeaderPageReq" Grid.Row="0" Margin="16,12"  >
                    <Grid ShowGridLines="False" >
                        <Grid.ColumnDefinitions >
                            <ColumnDefinition Width="0"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Zone d'affichage des TextBlock -->
                        <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Vertical" >
                                <TextBlock FontSize="14" HorizontalAlignment="Left" >
                                    <Run Text="{lang:Loc NumberPart}" />
                                    <Run Text=" " /> 
                                    <Run Text="{Binding NumberOfParts,Mode=OneWay}" FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </TextBlock>

                                <TextBlock FontSize="14" HorizontalAlignment="Left">
                                    <Run Text="{lang:Loc NumberReq}" />
                                    <Run Text=" " /> 
                                    <Run Text="{Binding NumberOfReq,Mode=OneWay}" FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </TextBlock>
                            </StackPanel>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal"  HorizontalAlignment="Center" Grid.Column="2">
                            <StackPanel Orientation="Vertical" Margin="10,0">
                                <TextBlock Margin="10,0" FontSize="14" HorizontalAlignment="Left" >
                                    <Run Text="{lang:Loc Folder}" />
                                    <Run Text=" : " />
                                    <Run Text="{Binding CurrentFolder, UpdateSourceTrigger=PropertyChanged}" />

                                </TextBlock>
                            </StackPanel>

                        </StackPanel>

                        <!-- Groupe des boutons à droite -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="3">
                            <ui:Button x:Name="BtnCreateReq" 
                                       Margin="8,0,0,0" 
                                       Command="{Binding CreateRequirementCommand}" 
                                       Style="{StaticResource HeaderIconButtonStyle}" 
                                       ToolTip="Création d'une pièce"  >
                                <Image Source="/Asset/add_req2.png" Stretch="Uniform" />
                            </ui:Button>
                            <ui:Button x:Name="BtnDeleteReq"
                                       Margin="8,0,0,0" 
                                       Command="{Binding DeleteRequirementCommand}" 
                                       Style="{StaticResource HeaderIconButtonStyle}"
                                       ToolTip="{Binding ToolTipDeletePart}" 
                                       ToolTipService.ShowDuration="6000">
                                <Image Source="/Asset/bin_req2.png" Stretch="Uniform" />
                            </ui:Button>

                            <Border Background="{DynamicResource DividerStrokeColorDefaultBrush}" Width="1" Height="40" Margin="8,0" />

                            <ui:Button x:Name="MultiEditButton"
                                       Style="{StaticResource HeaderIconButtonStyle}"
                                       ToolTip="Edition multiple des données" >
                                <Image Source="/Asset/MultiEdit.png" Stretch="Uniform"/>
                            </ui:Button>
                            <ui:Button x:Name="SaveButton"
                                        Style="{StaticResource HeaderIconButtonStyle}"
                                        Icon="{ui:SymbolIcon Save24}" FontSize="35"
                                        Margin="8,0,0,0" 
                                        Command="{Binding SaveCommand}"
                                        ToolTip="Sauvegade totale" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="BarreReq" Grid.Row="1" >
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="3" BlurRadius="6" Opacity="0.4"/>
                    </Border.Effect>
                    <Border Background="{DynamicResource DividerStrokeColorDefaultBrush}" Height="1" Margin="20,0,20,0" VerticalAlignment="Bottom"/>
                </Border>

                <!-- Zone de saisie des valeurs -->
                <Grid x:Name="GridItems" Grid.Row="2" ShowGridLines="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Zone principale : Liste (liste doit être dans Row=1) -->
                    <Grid >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">

                            <TextBox Width="180"
                                     Margin="0,0,10,0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding ViewMode,
                                     Converter={StaticResource EnumEqualsToVisibilityConverter},
                                     ConverterParameter=SearchOnly}"
                                     />

                            <ComboBox Width="160"
                                      Margin="0,0,0,0"
                                      ItemsSource="{Binding ViewModes}"
                                      SelectedItem="{Binding ViewMode, Mode=TwoWay}" />
                        </StackPanel>


                        <!-- LISTE scrollable + virtualisée : on utilise ListBox (contient ScrollViewer) -->
                        <ListBox Grid.Row="0"
                                 x:Name="ListBoxReqs"
                                 ItemsSource="{Binding FilteredRequirements}"
                                 SelectedItem="{Binding SelectedRequirement, Mode=TwoWay}"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Focusable="False"
                                 SelectionMode="Single"
                                 Margin="0,30,0,0"
                                 ItemContainerStyle="{DynamicResource ListBoxReqs}">

                            <!-- Panel virtualisant -->
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <!-- Template de l'item (votre PanelReqs) -->
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Requirements}">
                                    <localControls:PanelReqs
                                                    Requirement="{Binding}"
                                                    ParentViewModel="{Binding DataContext, RelativeSource={RelativeSource AncestorType=local:PageReq}}"
                                                    Margin="0,5,0,5"
                                                    Padding="10"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty panel : affiché seulement si pas d'items -->
                        <Grid Grid.Row="0" Height="400" Margin="0,50,0,0" VerticalAlignment="Stretch"
                          Visibility="{Binding Requirements.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock Text="{lang:Loc NoReqData1}" Style="{StaticResource EmptyDataTextBlockStyle}"/>
                                <TextBlock Text="{lang:Loc NoReqData2}" Style="{StaticResource EmptyDataTextBlockStyle}"/>
                                <Image Source="/Asset/ImageEmptyReqs.png" MaxWidth="700" Margin="0" Stretch="Fill"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Footer fixe (en dehors de la zone scrollable) -->
                    <Grid Visibility="Collapsed" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource DividerStrokeColorDefaultBrush}" Height="1" Margin="10,0,10,0"/>
                        <TextBlock Grid.Row="1" Text="Page de modélisation pour l'application TOLTECH - Développée par Louis PERIER"
                   FontSize="20" HorizontalAlignment="Center" Margin="5"/>
                    </Grid>

                    <!-- Header flottant : filtres d'affichage -->
                    <Grid x:Name="FloatingHeader"
      Grid.Row="0"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Top"
      Panel.ZIndex="10">

                        <!-- Animation verticale du header -->
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="HeaderTransform" Y="0"/>
                        </Grid.RenderTransform>

                        <!-- Conteneur des filtres -->
                        <Border HorizontalAlignment="Stretch"
            Background="Transparent"
            Panel.ZIndex="2"
            MouseEnter="FloatingHeader_MouseEnter"
            MouseLeave="FloatingHeader_MouseLeave">

                            <!--
            UniformGrid répartit les filtres équitablement.
            Le WrapPanel permet un retour à la ligne si nécessaire.
        -->
                            <WrapPanel x:Name="StackHeaderButtons"
                   Orientation="Horizontal"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top">

                                <!-- Filtre : Part 1 -->
                                <Border MinWidth="100"
                    Padding="10,5"
                    
                    Background="Transparent">

                                    <StackPanel HorizontalAlignment="Center">

                                        <ui:TextBlock Text="{lang:Loc Part1}"
                                  HorizontalAlignment="Center"
                                  TextAlignment="Center"
                                  TextWrapping="Wrap"
                                  />

                                        <ui:ToggleSwitch Tag="1"
                                     HorizontalAlignment="Center"
                                     IsChecked="{Binding IsEyeVisible1, Mode=TwoWay}"
                                     Opacity="0.8"/>
                                    </StackPanel>
                                </Border>

                                <!-- Filtre : Part 2 -->
                                <Border MinWidth="100"
                    Padding="10,5"
                    
                    Background="Transparent">

                                    <StackPanel HorizontalAlignment="Center">

                                        <ui:TextBlock Text="{lang:Loc Part2}"
                                  HorizontalAlignment="Center"
                                  TextAlignment="Center"
                                  TextWrapping="Wrap"
                                  />

                                        <ui:ToggleSwitch Tag="2"
                                     HorizontalAlignment="Center"
                                     IsChecked="{Binding IsEyeVisible2, Mode=TwoWay}"
                                     Opacity="0.8"/>
                                    </StackPanel>
                                </Border>

                                <!-- Filtre : Coordonnées -->
                                <Border MinWidth="100"
                    Padding="10,5"
                    
                    Background="Transparent">

                                    <StackPanel HorizontalAlignment="Center">

                                        <ui:TextBlock Text="{lang:Loc Coordinate}"
                                  HorizontalAlignment="Center"
                                  TextAlignment="Center"
                                  TextWrapping="Wrap"
                                  />

                                        <ui:ToggleSwitch Tag="3"
                                     HorizontalAlignment="Center"
                                     IsChecked="{Binding IsEyeVisible3, Mode=TwoWay}"
                                     Opacity="0.8"/>
                                    </StackPanel>
                                </Border>

                                <!-- Filtre : Commentaire -->
                                <Border MinWidth="100"
                    Padding="10,5"
                    
                    Background="Transparent">

                                    <StackPanel HorizontalAlignment="Center">

                                        <ui:TextBlock Text="{lang:Loc Comment}"
                                  HorizontalAlignment="Center"
                                  TextAlignment="Center"
                                  TextWrapping="Wrap"
                                  />

                                        <ui:ToggleSwitch Tag="4"
                                     HorizontalAlignment="Center"
                                     IsChecked="{Binding IsEyeVisible4, Mode=TwoWay}"
                                     Opacity="0.8"/>
                                    </StackPanel>
                                </Border>

                            </WrapPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>


    </DockPanel>
</UserControl>
