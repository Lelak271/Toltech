<ui:FluentWindow
    x:Class="Toltech.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:Toltech.App.Views"
    xmlns:controls="clr-namespace:Toltech.App.FrontEnd.Controls"
    xmlns:vm="clr-namespace:Toltech.App.ViewModels"
    xmlns:conv="clr-namespace:Toltech.App.Converters"
    xmlns:lang="clr-namespace:Toltech.App.Resources.Lang"
    x:Name="MainWindowApp"
    Width="1200"
    Height="600"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None"
    WindowCornerPreference="Default"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    ResizeMode="CanResize"
    FlowDirection="LeftToRight"
    >

    <ui:FluentWindow.Resources>

        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter"/>
        <conv:DensityUnitToSymbolConverter x:Key="DensityUnitToSymbolConverter"/>

        <!-- ===== Remplacement des RibbonGroupBox : GroupBox avec titre en bas ===== -->
        <Style x:Key="RibbonGroupStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="0,0,1,0"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ContentPresenter Grid.Row="0" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Row="1"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,4,0,0"
                                                  TextElement.FontSize="11"
                                                  TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton "grande icône" (équivalent SizeDefinition=Large) -->
        <Style x:Key="RibbonLargeButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <!-- Bouton "ligne" (équivalent SizeDefinition=Middle / Small) -->
        <Style x:Key="RibbonSmallButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="RibbonIconStyle" TargetType="Image">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

    </ui:FluentWindow.Resources>

    <Grid x:Name="GridApplication" Margin="0" ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <!-- TitleBar -->
            <RowDefinition Height="160"/>
            <!-- Ruban (tabs + commandes) -->
            <RowDefinition Height="35"/>
            <!-- Navigation -->
            <RowDefinition Height="*"/>
            <!-- Contenu -->
        </Grid.RowDefinitions>

        <Grid.Background>
            <!--<ImageBrush ImageSource="/Asset/FontStars.jpg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>-->
            <!--<SolidColorBrush Color="{DynamicResource ApplicationBackgroundBrush}"/>-->
            <DynamicResource ResourceKey="ApplicationBackgroundBrush"/>
        </Grid.Background>

        <!-- ======================= TITLE BAR ======================= -->
        <!-- Les boutons Minimize / Maximize / Close sont gérés nativement par WPF-UI -->
        <ui:TitleBar x:Name="AppTitleBar"
                     Grid.Row="0"
                     Title="{Binding ModelName, StringFormat='TOLTECH Application - {0}'}"/>

        <!-- ======================= "RIBBON" (TabControl) ======================= -->
        <TabControl x:Name="AppRibbon"
                    Grid.Row="1"
                    Padding="0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">

            <!-- ===== Onglet Modèle ===== -->
            <TabItem Header="{lang:Loc RibbonTabModel}">
                <StackPanel Orientation="Horizontal" Margin="4">

                    <GroupBox Header="{lang:Loc Test}" Style="{StaticResource RibbonGroupStyle}">
                        <ui:Button Padding="5"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsDefault="True">
                            <Image Source="/Asset/logo_toltech.png" Height="48"/>
                        </ui:Button>
                    </GroupBox>

                    <GroupBox Header="{lang:Loc GroupModels}" Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ui:Button Grid.Row="0" Grid.Column="0"
                                       Style="{StaticResource RibbonSmallButtonStyle}"
                                       Content="{lang:Loc CreateWord}"
                                       Command="{Binding CreateModelCommand}"
                                       ToolTip="{lang:Loc TipCreateModel}">
                                <ui:Button.Icon>
                                    <ui:ImageIcon Source="/Asset/add_model2.png" Width="16" Height="16"/>
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Grid.Row="0" Grid.Column="1"
                                       Style="{StaticResource RibbonSmallButtonStyle}"
                                       Content="{lang:Loc OpenWord}"
                                       Command="{Binding OpenModelFileCommand}"
                                       ToolTip="{lang:Loc TipOpenModel}">
                                <ui:Button.Icon>
                                    <ui:ImageIcon Source="/Asset/open_model2.png" Width="16" Height="16"/>
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Grid.Row="1" Grid.Column="0"
                                       Style="{StaticResource RibbonSmallButtonStyle}"
                                       Content="{lang:Loc Link}"
                                       Command="{Binding OpenRegisterWindowCommand}"
                                       ToolTip="{DynamicResource TipLinkModel}">
                                <ui:Button.Icon>
                                    <ui:ImageIcon Source="/Asset/Associate_modele.png" Width="16" Height="16"/>
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Grid.Row="1" Grid.Column="1"
                                       Style="{StaticResource RibbonSmallButtonStyle}"
                                       Content="{lang:Loc DuplicateWord}"
                                       Command="{Binding DuplicateActiveModelCommand}"
                                       ToolTip="{DynamicResource TipDuplicateModel}">
                                <ui:Button.Icon>
                                    <ui:ImageIcon Source="/Asset/duplicate_model2.png" Width="16" Height="16"/>
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Grid.Row="2" Grid.Column="0"
                                       Style="{StaticResource RibbonSmallButtonStyle}"
                                       Content="{lang:Loc DeleteWord}"
                                       Command="{Binding DeleteActiveModelCommand}"
                                       ToolTip="{DynamicResource TipDeleteModel}">
                                <ui:Button.Icon>
                                    <ui:ImageIcon Source="/Asset/bin_model2.png" Width="16" Height="16"/>
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="{lang:Loc GroupParts}" Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Style="{StaticResource RibbonLargeButtonStyle}"
                                       Command="{Binding CreatePartCommand}"
                                       ToolTip="{DynamicResource TipCreatePart}">
                                <StackPanel>
                                    <Image Source="/Asset/add_part2.png" Style="{StaticResource RibbonIconStyle}"/>
                                    <TextBlock Text="{lang:Loc CreateWord}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Style="{StaticResource RibbonLargeButtonStyle}"
                                       Command="{Binding ShowWindowDeletePartCommand}"
                                       ToolTip="{DynamicResource TipDeletePart}">
                                <StackPanel>
                                    <Image Source="/Asset/bin_part2.png" Style="{StaticResource RibbonIconStyle}"/>
                                    <TextBlock Text="{lang:Loc DeleteWord}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{lang:Loc GroupRequirements}" Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Style="{StaticResource RibbonLargeButtonStyle}"
                                       Command="{Binding CreateRequirementCommand}"
                                       ToolTip="{DynamicResource TipCreateReq}">
                                <StackPanel>
                                    <Image Source="/Asset/add_req2.png" Style="{StaticResource RibbonIconStyle}"/>
                                    <TextBlock Text="{lang:Loc CreateWord}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                            <!-- NB : la commande d'origine était ShowWindowDeletePartCommand (copier-coller ?) -->
                            <ui:Button Style="{StaticResource RibbonLargeButtonStyle}"
                                       Command="{Binding ShowWindowDeletePartCommand}"
                                       ToolTip="{DynamicResource TipDeleteReq}">
                                <StackPanel>
                                    <Image Source="/Asset/bin_req2.png" Style="{StaticResource RibbonIconStyle}"/>
                                    <TextBlock Text="{lang:Loc DeleteWord}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{lang:Loc InformationWord}" Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{lang:Loc EditionModel}"/>
                                <TextBlock x:Name="TitleInfo" Text="{Binding ModelName}" Margin="5,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{lang:Loc GroupPathModel}"/>
                                <TextBlock x:Name="PathModel"
                                           Text="{Binding ModelActif}"
                                           Margin="5,0"
                                           TextWrapping="NoWrap"
                                           ToolTip="{DynamicResource TipCopyPath}"/>
                                <ui:Button Width="30" Height="25" Padding="0"
                                           ToolTip="{DynamicResource TipMoveModel}"
                                           Icon="{ui:SymbolIcon FolderArrowRight24}"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </TabItem>

            <!-- ===== Onglet Calculs ===== -->
            <TabItem Header="{lang:Loc CalculsWord}" Visibility="Visible">
                <StackPanel Orientation="Horizontal" Margin="4">

                    <GroupBox Header="{lang:Loc GroupValidation}" Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button x:Name="CheckInverseButton"
                                       Style="{StaticResource RibbonLargeButtonStyle}"
                                       Click="CheckInverseButton_Click">
                                <StackPanel>
                                    <Image Source="/Asset/HyperstatismeLogo2.png" Style="{StaticResource RibbonIconStyle}"/>
                                    <TextBlock Text="{lang:Loc BtnIsostatisme}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                            <ui:Button x:Name="AfficherMatriceButton"
                                       Style="{StaticResource RibbonLargeButtonStyle}"
                                       Margin="20,2,2,2"
                                       Click="AfficherMatriceButton_Click">
                                <StackPanel>
                                    <Image Source="/Asset/TestGrapheButton.png" Style="{StaticResource RibbonIconStyle}"/>
                                    <TextBlock Text="{lang:Loc BtnMatrixPreview}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                            <ui:Button x:Name="dded"
                                       Style="{StaticResource RibbonLargeButtonStyle}"
                                       Margin="20,2,2,2"
                                       Click="GenerateGraph_Click">
                                <StackPanel>
                                    <Image Source="/Asset/Graphe.png" Style="{StaticResource RibbonIconStyle}"/>
                                    <TextBlock Text="{lang:Loc BtnGraph}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Étude" Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button x:Name="BtnCalculs"
                                       Style="{StaticResource RibbonLargeButtonStyle}"
                                       Click="GenerateGraph_Click"
                                       ToolTip="Lancer les calculs d'analyse et d'étude">
                                <StackPanel>
                                    <Image Source="/Asset/Logo_DB_tol.png" Style="{StaticResource RibbonIconStyle}"/>
                                    <TextBlock Text="Calculs" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                            <StackPanel VerticalAlignment="Center">
                                <ui:Button x:Name="BtnExportExcel"
                                           Style="{StaticResource RibbonSmallButtonStyle}"
                                           Content="Excel"
                                           Click="GenerateGraph_Click"
                                           ToolTip="Exporter les résultats vers Excel">
                                    <ui:Button.Icon>
                                        <ui:ImageIcon Source="/Asset/Logo_Excel.png" Width="16" Height="16"/>
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button x:Name="BtnExportGsheet"
                                           Style="{StaticResource RibbonSmallButtonStyle}"
                                           Content="GSheet"
                                           Click="GenerateGraph_Click"
                                           ToolTip="Exporter les résultats vers Google Sheets">
                                    <ui:Button.Icon>
                                        <ui:ImageIcon Source="/Asset/Logo_GSheet.png" Width="16" Height="16"/>
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </TabItem>

            <!-- ===== Onglet Base de données ===== -->
            <TabItem Header="{lang:Loc RibbonTabDatabase}">
                <StackPanel Orientation="Horizontal" Margin="4">
                    <GroupBox Header="{lang:Loc GroupDatabaseLinks}" Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button x:Name="OpenDataBaseButton"
                                       Style="{StaticResource RibbonLargeButtonStyle}"
                                       Click="OpenFloatingPanelDB_Click">
                                <StackPanel>
                                    <Image Source="/Asset/Logo_DB_tol.png" Style="{StaticResource RibbonIconStyle}"/>
                                    <TextBlock Text="{lang:Loc BtnTol}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                            <ui:Button x:Name="OpenDataBasePartButton"
                                       Style="{StaticResource RibbonLargeButtonStyle}"
                                       Margin="20,2,2,2"
                                       Click="OpenFloatingPartDB_Click">
                                <StackPanel>
                                    <Image Source="/Asset/Logo_DB_EXI.png" Style="{StaticResource RibbonIconStyle}"/>
                                    <TextBlock Text="{lang:Loc BtnPart}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                            <ui:Button x:Name="OpenDataBaseModelButton"
                                       Style="{StaticResource RibbonLargeButtonStyle}"
                                       Margin="20,2,2,2"
                                       Click="OpenFloatingPanelDB_Click">
                                <StackPanel>
                                    <Image Source="/Asset/Logo_DB_MODEL.png" Style="{StaticResource RibbonIconStyle}"/>
                                    <TextBlock Text="{lang:Loc BtnMod}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <!-- ===== Onglet Analyse (masqué) ===== -->
            <TabItem Header="{lang:Loc AnalyseWord}" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="4">
                    <GroupBox Header="Options" Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Style="{StaticResource RibbonSmallButtonStyle}" Content="Sauvegarder"/>
                            <ui:Button Style="{StaticResource RibbonSmallButtonStyle}" Content="Exporter CSV"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <!-- ===== Onglet Paramètres ===== -->
            <TabItem Header="{lang:Loc RibbonTabParameter}">
                <StackPanel Orientation="Horizontal" Margin="4">
                    <GroupBox Header="Options" Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Style="{StaticResource RibbonLargeButtonStyle}"
                                       Click="OpenFloatingParametre_Click">
                                <StackPanel>
                                    <ui:SymbolIcon Symbol="Settings24" FontSize="28" Margin="0,0,0,4"/>
                                    <TextBlock Text="{lang:Loc RibbonTabParameter}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>

                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="{lang:Loc ParamSentence}" FontWeight="Bold" Margin="0,0,0,5"/>

                                <StackPanel Orientation="Horizontal" Margin="5,0">
                                    <TextBlock Text="{lang:Loc LanguageLabel}"/>
                                    <TextBlock Text=" : "/>
                                    <TextBlock Text="{DynamicResource Language}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="5,0">
                                    <TextBlock Text="{lang:Loc UnitLabel}"/>
                                    <TextBlock Text=" : "/>
                                    <TextBlock Text="{DynamicResource DefaultUnit}"/>
                                    <TextBlock Text=" / "/>
                                    <TextBlock Text="{DynamicResource DefaultAngle}"/>
                                    <TextBlock Text=" / "/>
                                    <TextBlock Text="{DynamicResource DensityUnit}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

        </TabControl>

        <!-- ======================= Navigation Tab ======================= -->
        <StackPanel x:Name="AppTabItems" Grid.Row="2" Orientation="Vertical">
            <TabControl Name="TabNavigation"
                        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                        Width="Auto">
                <TabItem  Header="🏠" Width="45" FontSize="15" Padding="0" HorizontalContentAlignment="Center"/>
                <TabItem  Header="{lang:Loc TabModels}" Width="Auto" HorizontalContentAlignment="Center"/>
                <TabItem  Header="{lang:Loc TabModeling}" Width="Auto" HorizontalContentAlignment="Center"/>
                <TabItem  Header="{lang:Loc TabRequirements}" Width="Auto" HorizontalContentAlignment="Center"/>
                <TabItem  Header="{lang:Loc TabResults}" Width="Auto" HorizontalContentAlignment="Center"/>
                <TabItem  Header="{lang:Loc TabV3D}" Width="Auto" HorizontalContentAlignment="Center"/>
            </TabControl>
            <Border Height="1" Background="Gray" HorizontalAlignment="Stretch" Margin="10,-5,10,0"/>
        </StackPanel>

        <!-- ======================= Contenu ======================= -->
        <ContentControl Content="{Binding SelectedPage}" Grid.Row="3">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type vm:HomePageViewModel}">
                    <views:HomePage/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:ModelsViewModel}">
                    <views:PageModels/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:DatasViewModel}">
                    <views:PageData/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:RequirementsViewModel}">
                    <views:PageReq/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:ResultsViewModel}">
                    <views:PageResultats/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:V3DViewModel}">
                    <views:VSTWindow/>
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>

        <!-- ======================= Logger ======================= -->
        <Grid x:Name="LoggerGrid" Grid.Row="3" Height="33" VerticalAlignment="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="6"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Height" Value="Auto"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusBarVM.IsExpanded}" Value="False">
                            <Setter Property="Height" Value="30"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Zone de resize -->
            <Thumb Grid.Row="0"
                   Cursor="SizeNS"
                   DragDelta="ResizeThumb_DragDelta"
                   Visibility="{Binding StatusBarVM.IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Contenu logger -->
            <controls:LogViewerControl Grid.Row="1"
                                       DataContext="{Binding StatusBarVM}"
                                       VerticalAlignment="Stretch"/>
        </Grid>

        <!-- ======================= Overlay notifications ======================= -->
        <Grid Grid.Row="3"
              x:Name="NotificationLayer"
              IsHitTestVisible="True"
              Panel.ZIndex="999">
            <ContentPresenter x:Name="NotificationHost"
                              Content="{Binding CurrentNotification}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Bottom"
                              Margin="10"/>
        </Grid>

    </Grid>
</ui:FluentWindow>
