<UserControl
    x:Class="Toltech.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:lang="clr-namespace:Toltech.App.Resources.Lang">

    <UserControl.Resources>
        <!-- Carte -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
        </Style>

        <!-- Pastille d'information -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        </Style>

        <!-- Titre de section -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>

        <!-- Tuile d'action rapide -->
        <Style x:Key="ActionTile" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Padding" Value="14,16"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>

        <!-- Lien d'aide -->
        <Style x:Key="LinkButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Appearance" Value="Secondary"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== BARRE DU HAUT ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <ui:TextBox Width="500"
                        HorizontalAlignment="Center"
                        PlaceholderText="PlaceHolder"
                        Icon="{ui:SymbolIcon Search24}"/>
            <Border Name="HeaderPage1" Visibility="Collapsed"/>
        </Grid>

        <!-- ===== CONTENU ===== -->
        <Grid Name="MainPage1" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!--  Carte présentation  -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Image Source="/Asset/Logo_TT.png"
                               Stretch="Uniform"
                               MaxHeight="180"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>

                        <TextBlock Text="{Binding NameApp}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                        <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,18">
                            <Border Style="{StaticResource Chip}">
                                <TextBlock Text="{Binding AppVersion}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Border>
                            <Border Style="{StaticResource Chip}">
                                <TextBlock Text="{Binding Framework}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Border>
                            <Border Style="{StaticResource Chip}"
                                    Margin="0"
                                    Background="{DynamicResource SystemFillColorCriticalBrush}">
                                <TextBlock Text="BETA" FontSize="12" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </WrapPanel>

                        <TextBlock Text="{lang:Loc AppDescription1}"
                                   FontSize="14" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{lang:Loc AppDescription2}"
                                   FontSize="14" TextWrapping="Wrap" Margin="0,0,0,16"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <Separator Margin="0,0,0,12"/>

                        <TextBlock Text="{lang:Loc AppCreator}"
                                   FontSize="12" FontStyle="Italic" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  Colonne de droite  -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- ===== Actions rapides ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <ui:SymbolIcon Symbol="Flash24" FontSize="22" Margin="0,0,10,0"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Actions rapides" Style="{StaticResource SectionTitle}"/>
                            </StackPanel>

                            <WrapPanel>
                                <ui:Button x:Name="OpenModelButton"
                                           Style="{StaticResource ActionTile}"
                                           Icon="{ui:SymbolIcon FolderOpen24}"
                                           Content="Ouvrir un modèle"/>
                                <ui:Button x:Name="OpenPartsDbButton"
                                           Style="{StaticResource ActionTile}"
                                           Icon="{ui:SymbolIcon Box24}"
                                           Content="Base de pièces"/>
                                <ui:Button x:Name="NewRequirementButton"
                                           Style="{StaticResource ActionTile}"
                                           Icon="{ui:SymbolIcon DocumentAdd24}"
                                           Content="Nouvelle exigence"/>
                                <ui:Button x:Name="OpenSettingsButton"
                                           Style="{StaticResource ActionTile}"
                                           Icon="{ui:SymbolIcon Settings24}"
                                           Content="Paramètres"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== Modèle actif ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="Cube24" FontSize="22" Margin="0,0,10,0"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Modèle actif" Style="{StaticResource SectionTitle}"/>
                            </StackPanel>

                            <!-- Nom du modèle (bindings à adapter à ton ViewModel) -->
                            <TextBlock Text="{Binding ModelName, FallbackValue='Aucun modèle ouvert'}"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                            <WrapPanel Margin="0,10,0,14">
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text="{Binding Parts.Count, Mode=OneWay, FallbackValue=0}"/>
                                        <Run Text="pièce(s)"/>
                                    </TextBlock>
                                </Border>
                            </WrapPanel>

                            <ui:Button x:Name="ResumeModelButton"
                                       Content="Reprendre le travail"
                                       Icon="{ui:SymbolIcon ArrowRight24}"
                                       Appearance="Primary"
                                       HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== Aide et ressources ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <ui:SymbolIcon Symbol="BookQuestionMark24" FontSize="22" Margin="0,0,10,0"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Aide et ressources" Style="{StaticResource SectionTitle}"/>
                            </StackPanel>

                            <WrapPanel>
                                <ui:Button x:Name="QuickStartButton"
                                           Style="{StaticResource LinkButton}"
                                           Icon="{ui:SymbolIcon Rocket24}"
                                           Content="Démarrage rapide"/>
                                <ui:Button x:Name="DocumentationButton"
                                           Style="{StaticResource LinkButton}"
                                           Icon="{ui:SymbolIcon Document24}"
                                           Content="Documentation"/>
                                <ui:HyperlinkButton  x:Name="GitRepositoryButton"
                                           Style="{StaticResource LinkButton}"
                                           Icon="{ui:SymbolIcon Code24}"
                                           Content="Dépôt Git"
                                           NavigateUri="https://github.com/Lelak271/Toltech"/>
                                <ui:Button x:Name="ReportBugButton"
                                           Style="{StaticResource LinkButton}"
                                           Icon="{ui:SymbolIcon Bug24}"
                                           Content="Signaler un bug"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== To-Do ===== -->
                    <Border Style="{StaticResource Card}" Padding="24,20,24,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="TaskListSquareLtr24" FontSize="22" Margin="0,0,10,0"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="To-Do List Beta Features" Style="{StaticResource SectionTitle}"/>
                            </StackPanel>

                            <ListBox x:Name="ToDoListBox"
                                     ItemsSource="{Binding ToDoItems}"
                                     MaxHeight="260"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsDone}" Margin="4,2">
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== PIED DE PAGE ===== -->
        <TextBlock Name="FooterPage1"
                   Grid.Row="2"
                   Margin="0,12,0,0"
                   HorizontalAlignment="Center"
                   FontSize="12"
                   Text="© 2025 Toltech - Tous droits réservés"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
    </Grid>
</UserControl>
