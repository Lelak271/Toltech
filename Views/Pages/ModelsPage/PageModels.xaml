<UserControl x:Class="Toltech.App.Views.PageModels"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:localControls="clr-namespace:Toltech.App.FrontEnd.Controls"
             xmlns:models="clr-namespace:Toltech.App.Models"
             xmlns:lang="clr-namespace:Toltech.App.Resources.Lang"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Style des petits boutons d'action : icône + texte côte à côte -->
        <Style x:Key="HeaderActionButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- Conteneur "carte" : pas d'Effect sur un gros conteneur (coûteux en rendu) -->
    <Border Margin="12"
            CornerRadius="8"
            BorderThickness="1"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ======================= EN-TÊTE ======================= -->
            <Grid x:Name="HeaderPageModel" Grid.Row="0" Margin="20,16,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Titre + sous-titre -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{lang:Loc SaveModel}"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{lang:Loc LibraryToltech}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text=" · "
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding ModelName}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <!-- Recherche -->
                <ui:TextBox x:Name="FilterTextBox"
                            Grid.Column="1"
                            Width="260"
                            VerticalAlignment="Center"
                            ClearButtonEnabled="True"
                            PlaceholderText="{lang:Loc SentFilterBar}"
                            ToolTip="{lang:Loc FilterByName}"
                            Icon="{ui:SymbolIcon Search24}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0">
                    <ui:Button x:Name="BtnCreateModel"
                               Style="{StaticResource HeaderActionButton}"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Add24}"
                               Content="{lang:Loc CreateWord}"
                               ToolTip="{lang:Loc TipCreateModel}"
                               Command="{Binding CreateCommand}"/>
                    <ui:Button x:Name="BtnDeleteModel"
                               Style="{StaticResource HeaderActionButton}"
                               Appearance="Danger"
                               Icon="{ui:SymbolIcon Delete24}"
                               Content="{lang:Loc DeleteWord}"
                               ToolTip="{DynamicResource TipDeleteModel}"
                               Command="{Binding DeleteActiveModelCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Séparateur (remplace le Border + DropShadow) -->
            <Separator Grid.Row="1" Margin="20,0"/>

            <!-- ======================= LISTE ======================= -->
            <!-- ListBox = virtualisation + scroll intégrés. VirtualizingStackPanel est déjà le panel par défaut. -->
            <ListBox x:Name="ListBoxReqs"
                     Grid.Row="2"
                     ItemsSource="{Binding FilteredModels}"
                     SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                     SelectionMode="Single"
                     ItemContainerStyle="{DynamicResource ListBoxReqs}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0,12,0,12"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ModelMeta}">
                        <localControls:PanelModelMeta Margin="20,5" Padding="10"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ======================= ÉTAT VIDE ======================= -->
            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="True">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Models.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Image Source="/Asset/ImageEmptyModels.png"
                       MaxWidth="500"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <ui:Button Style="{StaticResource HeaderActionButton}"
                           Appearance="Primary"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"
                           Icon="{ui:SymbolIcon Add24}"
                           Content="{lang:Loc CreateWord}"
                           Command="{Binding CreateCommand}"/>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
