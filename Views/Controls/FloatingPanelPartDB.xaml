<ui:FluentWindow x:Class="Toltech.App.FrontEnd.Controls.FloatingPanelPartDB"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Toltech.App.ViewModels"
        xmlns:behaviors="clr-namespace:Toltech.App.Behaviors"
        xmlns:conv="clr-namespace:Toltech.App.Converters"
        xmlns:lang="clr-namespace:Toltech.App.Resources.Lang"
        Width="960" Height="600"
        MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Closed="Window_Closed">

    <ui:FluentWindow.Resources>
        <conv:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
        <conv:DensityUnitConverter x:Key="DensityUnitConverter"/>
        
        <!-- Texte centré verticalement dans les cellules -->
        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <!-- Éditeur de cellule centré verticalement -->
        <Style x:Key="CellEditStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Menu affiché sur une ligne -->
        <ContextMenu x:Key="RowMenu">
            <MenuItem Header="Créer une pièce" Command="{Binding CreateCommand}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Add24"/>
                </MenuItem.Icon>
            </MenuItem>
            <!-- Sous-menu Image -->
            <MenuItem Header="Image">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Image24"/>
                </MenuItem.Icon>

                <MenuItem Header="Insérer une image" Command="{Binding InsertImageCommand}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="ImageAdd24"/>
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="Effacer l'image" Command="{Binding EraseImageCommand}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="ImageOff24"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Supprimer la sélection" Command="{Binding DeleteCommand}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Delete24"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Menu affiché dans la zone vide -->
        <ContextMenu x:Key="EmptyMenu">
            <MenuItem Header="Créer une pièce" Command="{Binding CreateCommand}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Add24"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Barre de titre -->
            <RowDefinition Height="Auto"/>
            <!-- En-tête -->
            <RowDefinition Height="*"/>
            <!-- Liste -->
            <RowDefinition Height="Auto"/>
            <!-- Actions -->
        </Grid.RowDefinitions>

        <!-- ======================= TITLE BAR ======================= -->
        <ui:TitleBar x:Name="AppTitleBar"
                     Grid.Row="0"
                     Title="{lang:Loc DatabasePartTitle}"/>

        <!-- ======================= EN-TÊTE ======================= -->
        <Grid Grid.Row="1" Margin="24,12,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Pastille d'icône -->
            <Border Width="44" Height="44"
                    CornerRadius="10"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <ui:SymbolIcon Symbol="Box24"
                               FontSize="22"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{lang:Loc ActiveModelParts}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="{Binding Parts.Count, Mode=OneWay}"/>
                    <Run Text="{lang:Loc Part_in_the_database}"/>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- ======================= LISTE (carte) ======================= -->
        <Border Grid.Row="2"
                Margin="24,8"
                Padding="4"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <DataGrid x:Name="PartsGrid"
                          ContextMenuOpening="PartsGrid_ContextMenuOpening"
                          ItemsSource="{Binding Parts}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserResizeRows="False"
                          CanUserResizeColumns="True"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                          Background="Transparent"
                          BorderThickness="0"
                          RowHeight="56"
                          behaviors:DataGridSelectedItemsBehavior.Enable="True"
                          behaviors:DataGridSelectedItemsBehavior.SelectedItems="{Binding SelectedParts}">

                    <DataGrid.Columns>
                        <!-- Indicateur de modification non enregistrée -->
                        <DataGridTemplateColumn Width="28" IsReadOnly="True" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="10" Height="10"
                     Fill="#F5B800"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False"
                     ToolTip="Modifications non enregistrées">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTextColumn Header="{lang:Loc Name}"
                                            Binding="{Binding NamePart}"
                                            Width="*"
                                            ElementStyle="{StaticResource CellTextStyle}"
                                            EditingElementStyle="{StaticResource CellEditStyle}"/>

                        <DataGridTextColumn Header="{lang:Loc MasseVol}"
                     Binding="{Binding MasseVol,
                              Converter={StaticResource DensityUnitConverter},
                              ConverterCulture=fr-FR,
                              StringFormat={}{0:G6}}"
                    Width="130"
                    ElementStyle="{StaticResource CellTextStyle}"
                    EditingElementStyle="{StaticResource CellEditStyle}">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- {Binding} = le contenu de Header, donc ton texte localisé -->
                                        <TextBlock Text="{Binding}"/>
                                        <TextBlock Text=" ("/>
                                        <TextBlock Text="{DynamicResource DensityUnitSymbol}"/>
                                        <TextBlock Text=")"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="{lang:Loc Comment}"
                                            Binding="{Binding Comment}"
                                            Width="2*"
                                            ElementStyle="{StaticResource CellTextStyle}"
                                            EditingElementStyle="{StaticResource CellEditStyle}"/>

                        <!-- Miniature -->
                        <DataGridTemplateColumn Header="{lang:Loc Picture}" Width="90" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Width="44" Height="44"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                                        <!-- Fond + icône par défaut -->
                                        <Border CornerRadius="6"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                                            <ui:SymbolIcon Symbol="Image24"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ImagePart}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </Border>

                                        <!-- Image avec les mêmes coins arrondis -->
                                        <Border CornerRadius="6">
                                            <Border.Background>
                                                <ImageBrush Stretch="UniformToFill"
                                    ImageSource="{Binding ImagePart, Converter={StaticResource ByteArrayToImageConverter}}"/>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actif / Inactif -->
                        <DataGridTemplateColumn Header="{lang:Loc Status}" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:ToggleSwitch HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     OnContent="Actif"
                                                     OffContent="Inactif"
                                                     IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>


                </DataGrid>

                <!-- État vide -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Parts.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <ui:SymbolIcon Symbol="Box24"
                                   FontSize="40"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="Aucune pièce pour ce modèle"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="Cliquez sur « Créer » pour en ajouter une."
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= ACTIONS ======================= -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="24,8,24,20">

            <ui:Button Content="Créer"
                       Icon="{ui:SymbolIcon Add24}"
                       Appearance="Secondary"
                       MinWidth="120"
                       Margin="0,0,8,0"
                       Command="{Binding CreateCommand}"/>

            <ui:Button Content="Supprimer"
                       Icon="{ui:SymbolIcon Delete24}"
                       Appearance="Danger"
                       MinWidth="120"
                       Margin="0,0,8,0"
                       Command="{Binding DeleteCommand}"/>

            <ui:Button Content="Enregistrer"
                       Icon="{ui:SymbolIcon Save24}"
                       Appearance="Primary"
                       MinWidth="130"
                       Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>