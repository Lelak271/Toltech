<ui:FluentWindow x:Class="Toltech.App.Views.Controls.CAD.CadPointSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="380"
        Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Acrylic"
        Title="Toltech — Sélection CAO"
        Loaded="Window_Loaded">

    <ui:FluentWindow.Resources>
        <Storyboard x:Key="SpinnerStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetName="SpinnerRotation"
                Storyboard.TargetProperty="Angle"
                From="0"
                To="360"
                Duration="0:0:1" />
        </Storyboard>
    </ui:FluentWindow.Resources>

    <ui:FluentWindow.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource SpinnerStoryboard}" />
        </EventTrigger>
    </ui:FluentWindow.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Barre de titre -->
            <RowDefinition Height="*" />
            <!-- Contenu -->
            <RowDefinition Height="Auto" />
            <!-- Actions -->
        </Grid.RowDefinitions>

        <!-- ======================= TITLE BAR ======================= -->
        <ui:TitleBar Grid.Row="0"
                     Title="Toltech — Sélection CAO"
                     ShowMinimize="False"
                     ShowMaximize="False" />

        <!-- ======================= CONTENU ======================= -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    Margin="24,0">

            <!-- Logo CAO avec spinner superposé -->
            <Grid Width="72"
                  Height="72"
                  HorizontalAlignment="Center"
                  Margin="0,0,0,16">

                <!-- Pastille de fond -->
                <Ellipse Width="72"
                         Height="72"
                         Fill="{DynamicResource ControlFillColorSecondaryBrush}" />

                <!-- Anneau qui tourne -->
                <Ellipse Width="60"
                         Height="60"
                         StrokeThickness="3"
                         Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                         StrokeDashArray="10 100"
                         StrokeStartLineCap="Round"
                         StrokeEndLineCap="Round"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotation" Angle="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Logo du logiciel CAO, au centre -->
                <Image Source="{Binding CadLogoPath}"
                       Width="28"
                       Height="28"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="{Binding CadDisplayName, StringFormat=Cliquer sur un point dans {0}.,UpdateSourceTrigger=PropertyChanged}"
                       HorizontalAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <TextBlock x:Name="HintTextBlock"
                       Text="{Binding HintMessage}"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Margin="0,8,0,0" />
        </StackPanel>

        <!-- ======================= ACTIONS ======================= -->
        <ui:Button Grid.Row="2"
                   Content="Annuler"
                   Icon="{ui:SymbolIcon Dismiss24}"
                   Appearance="Secondary"
                   MinWidth="110"
                   HorizontalAlignment="Right"
                   Margin="24,8,24,20"
                   Click="Cancel_Click" />
    </Grid>
</ui:FluentWindow>
