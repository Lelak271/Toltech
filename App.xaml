<Application x:Class="Toltech.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Toltech.App" 
             StartupUri="Views/Pages/MainWindow.xaml"
             ShutdownMode="OnExplicitShutdown"
             >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                
                <!-- Thème statique -->
                <ResourceDictionary Source="pack://application:,,,/Dragablz;component/Themes/Generic.xaml" />


                <ResourceDictionary Source="pack://application:,,,/Toltech.App;component/StylesApp.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Toltech.App;component/Resources/Styles/MainStyles.xaml" />


                
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </Application.Resources>

</Application>
